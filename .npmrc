# Restore pre-npm-v7 peer dependency resolution.
# @vercel/analytics 1.6.x added an optional SvelteKit peer that drags
# @sveltejs/vite-plugin-svelte@7 -> vite@8 into the resolution tree,
# conflicting with vite@5 locked by vitest/vitejs-plugin-react. npm 10
# resolves optional peers strictly now, so every install fails with
# ERESOLVE without this flag.
legacy-peer-deps=true

# Reduce supply-chain risk from newly published or compromised packages.
# Enforced by npm 11.21.1 in the security and dependency-remediation workflows.
# Explicit exceptions are reviewed security-fix releases whose patches are newer than 7 days.
min-release-age=7
min-release-age-exclude[]=resend
min-release-age-exclude[]=wrangler
min-release-age-exclude[]=miniflare
