# Vuka Music — environment variables
#
# This file is generated to match src/lib/env.ts (ENV_MANIFEST) exactly.
# If you add/remove/rename a variable, update env.ts FIRST, then mirror the
# change here — env.ts is the single source of truth and validates all of
# these at startup (see next.config.js).
#
# Legend: [required]            — app will refuse to start without it
#         [required-production] — optional in dev, required when NODE_ENV
#                                  or VERCEL_ENV is "production"
#         [optional]            — has a safe default or is feature-gated

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=              # [required] postgresql:// pooled connection (Supabase PgBouncer)
DIRECT_URL=                # [required] postgresql:// direct connection, used by `prisma migrate`

# ── Supabase Auth ────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=              # [required]
NEXT_PUBLIC_SUPABASE_ANON_KEY=         # [required]
SUPABASE_SERVICE_ROLE_KEY=             # [required] server-only JWT (starts with eyJ) — NEVER expose to client

# ── App ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://www.vukamusic.com   # [required] must start with https://
ADMIN_EMAIL=                                    # [required] server-only superadmin email
# NOTE: NEXT_PUBLIC_ADMIN_EMAIL intentionally does NOT exist — exposing the
# admin email to the client bundle was a real Phase 1 leak. Do not add it back.

# ── Cloudflare R2 ────────────────────────────────────────────────────────
CLOUDFLARE_R2_ACCOUNT_ID=          # [required]
CLOUDFLARE_R2_ACCESS_KEY_ID=       # [required]
CLOUDFLARE_R2_SECRET_ACCESS_KEY=   # [required]
CLOUDFLARE_R2_BUCKET_NAME=         # [required]
CLOUDFLARE_R2_PUBLIC_URL=          # [required] https:// R2 public CDN base URL
NEXT_PUBLIC_CF_CDN_URL=            # [optional] https:// Cloudflare CDN audio delivery URL

# ── Email (Resend) ───────────────────────────────────────────────────────
RESEND_API_KEY=                                 # [required]
EMAIL_FROM=noreply@mail.vukamusic.com           # [optional]

# ── Payments — Paystack (South Africa, primary rail) ────────────────────
PAYSTACK_SECRET_KEY=                        # [required] sk_live_... in prod, sk_test_... in dev
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=            # [optional] used by client-side Paystack.js pop-up

# ── Payments — PayPal (international) ────────────────────────────────────
# Required in production — all non-SA buyers and international payouts use PayPal.
PAYPAL_CLIENT_ID=              # [required-production]
PAYPAL_CLIENT_SECRET=          # [required-production]
PAYPAL_WEBHOOK_ID=             # [required-production] from developer.paypal.com, for signature verification
NEXT_PUBLIC_PAYPAL_CLIENT_ID=  # [optional]
PAYPAL_SANDBOX=false           # [optional] "true" to use PayPal sandbox in dev

# NOTE: PayFast, Stripe, and Flutterwave were REMOVED as payment rails.
# Do not add PAYFAST_*, STRIPE_*, or FLUTTERWAVE_* variables back — see the
# header comment in src/lib/env.ts for why, and the deprecation stubs at
# src/app/api/checkout/stripe/* for how stray webhook deliveries are handled.

# ── Security ──────────────────────────────────────────────────────────────
ENCRYPTION_KEY=     # [required] exactly 64 hex chars — `openssl rand -hex 32`
HMAC_KEY=            # [optional] 64 hex chars — `openssl rand -hex 32`
CRON_SECRET=         # [required] bearer token for /api/workers/cron, min 32 chars — `openssl rand -base64 32`

# ── Redis (Upstash) ──────────────────────────────────────────────────────
# Required in production — atomic rate limiting falls back to a DB-backed
# limiter in dev, but Upstash is required at scale in prod.
UPSTASH_REDIS_REST_URL=      # [required-production]
UPSTASH_REDIS_REST_TOKEN=    # [required-production]

# ── Monitoring ────────────────────────────────────────────────────────────
SENTRY_DSN=                    # [required-production] https://...sentry.io/...
NEXT_PUBLIC_POSTHOG_KEY=       # [optional]
NEXT_PUBLIC_POSTHOG_HOST=      # [optional]
LOG_SERVICE=vuka-app           # [optional] service name tag in structured logs
BETTER_UPTIME_API_KEY=         # [optional]
