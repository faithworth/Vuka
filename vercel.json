{
  "framework": "nextjs",
  "buildCommand": "node scripts/migrate.js && npx prisma generate && next build",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/workers/cron?job=search_sync",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/workers/cron?job=trending",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/workers/cron?job=milestones",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/workers/cron?job=cleanup",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/workers/cron?job=payout_process",
      "schedule": "0 9 * * 1-5"
    },
    {
      "path": "/api/workers/cron?job=marketplace_release",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/renew-plans",
      "schedule": "45 23 * * *"
    },
    {
      "path": "/api/cron/expire-plans",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/referral-rewards",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/campaign-deadlines",
      "schedule": "0 3 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "functions": {
    "src/app/api/migrate/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/workers/cron/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/dashboard/settings/upload-url/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/download/**": {
      "maxDuration": 60
    },
    "src/app/api/admin/**": {
      "maxDuration": 30
    },
    "src/app/api/checkout/paystack/webhook/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/purchase/**": {
      "maxDuration": 15
    }
  }
}