{
  "buildCommand": "npx prisma generate && next build",
  "installCommand": "npm install",
  "framework": "nextjs",
  "postDeploy": {
    "url": "/api/migrate",
    "method": "GET",
    "headers": {
      "x-cron-secret": "${CRON_SECRET}"
    }
  },
  "crons": [
    {
      "path": "/api/workers/cron?job=search_sync",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/workers/cron?job=trending",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/workers/cron?job=milestones",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/workers/cron?job=cleanup",
      "schedule": "0 5 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ],
  "functions": {
    "src/app/api/migrate/route.ts": {
      "maxDuration": 60
    }
  }
}
