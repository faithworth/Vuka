{
  "expo": {
    "name": "Vuka Music",
    "slug": "vuka-music",
    "version": "1.0.2",
    "orientation": "default",
    "description": "Vuka Music — the direct-to-fan music platform for artists, fans and the music industry.",
    "icon": "./assets/icon.png",
    "primaryColor": "#A0E87C",
    "backgroundColor": "#0A0A0A",
    "scheme": "vukamusic",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "platforms": ["ios", "android"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vukamusic.app",
      "buildNumber": "3",
      "icon": "./assets/icon.png",
      "config": { "usesNonExemptEncryption": false }
    },
    "android": {
      "package": "com.vukamusic.app",
      "versionCode": 3,
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0A"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "appVersion": "1.0.2",
      "publisher": "Vuka Music",
      "homepage": "https://www.vukamusic.com",
      "vukaUrl": "https://www.vukamusic.com",
      "releaseChannel": "stable"
    }
  }
}


