// ============================================================
// PATCH 01 — prisma/schema.prisma
// REPLACE the entire file with this content.
// Adds: Video, IndustryUser, Referral, Deal, DMCAReport,
//       Sample, Subscription, Merch, AdminLog models.
// Also fixes: Purchase.fee field, Beat.isExclusiveSold flag.
// Run after replacing:
//   npx prisma migrate dev --name add_all_models
//   (or npx prisma db push for quick deploy)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String
  role         String         @default("fan")
  createdAt    DateTime       @default(now())
  artist       Artist?
  industryUser IndustryUser?
  purchases    Purchase[]
  supportsSent SupportTxn[]
  wishlist     WishlistItem[]
  follows      Follow[]
}

model Artist {
  id               String         @id @default(cuid())
  userId           String         @unique
  user             User           @relation(fields: [userId], references: [id])
  slug             String         @unique
  name             String
  bio              String         @default("")
  city             String         @default("")
  country          String         @default("ZA")
  genreTags        String[]
  photoUrl         String         @default("")
  coverUrl         String         @default("")
  socialLinks      Json           @default("{}")
  stripeAccountId  String?
  payfastMerchant  String?
  currency         String         @default("ZAR")
  isPublic         Boolean        @default(true)
  isVerified       Boolean        @default(false)
  totalPlays       Int            @default(0)
  beats            Beat[]
  releases         Release[]
  videos           Video[]
  samples          Sample[]
  subscriptions    Subscription[]
  merch            Merch[]
  supportReceived  SupportTxn[]
  goals            Goal[]
  payouts          ArtistPayout[]
  followers        Follow[]
  dmcaReports      DMCAReport[]
  createdAt        DateTime       @default(now())
}

model Beat {
  id           String     @id @default(cuid())
  artistId     String
  artist       Artist     @relation(fields: [artistId], references: [id])
  title        String
  slug         String     @unique
  bpm          Int        @default(0)
  keySignature String     @default("")
  mood         String     @default("")
  genre        String     @default("")
  tags         String[]
  artworkUrl   String     @default("")
  previewUrl   String
  fullWavUrl   String     @default("")
  fullMp3Url   String     @default("")
  waveformData Float[]
  basicPrice   Float      @default(0)
  premiumPrice Float      @default(0)
  exclPrice    Float      @default(0)
  plays        Int        @default(0)
  sales        Int        @default(0)
  isActive     Boolean    @default(true)
  isExclusive  Boolean    @default(false)
  purchases    Purchase[]
  createdAt    DateTime   @default(now())
}

model Release {
  id          String     @id @default(cuid())
  artistId    String
  artist      Artist     @relation(fields: [artistId], references: [id])
  title       String
  slug        String     @unique
  releaseType String     @default("single")
  price       Float      @default(0)
  minPrice    Float      @default(0)
  payWhatWant Boolean    @default(false)
  artworkUrl  String     @default("")
  description String     @default("")
  credits     String     @default("")
  releaseDate DateTime?
  plays       Int        @default(0)
  sales       Int        @default(0)
  isActive    Boolean    @default(true)
  tracks      Track[]
  purchases   Purchase[]
  createdAt   DateTime   @default(now())
}

model Track {
  id           String   @id @default(cuid())
  releaseId    String
  release      Release  @relation(fields: [releaseId], references: [id])
  title        String
  trackNumber  Int
  duration     Int      @default(0)
  previewUrl   String
  fullUrl      String
  waveformData Float[]
}

model Video {
  id           String     @id @default(cuid())
  artistId     String
  artist       Artist     @relation(fields: [artistId], references: [id])
  title        String
  slug         String     @unique
  description  String     @default("")
  genre        String     @default("")
  tags         String[]
  thumbnailUrl String     @default("")
  videoUrl     String     // R2 private key
  previewUrl   String     @default("") // 30-sec preview key
  price        Float      @default(0)
  plays        Int        @default(0)
  sales        Int        @default(0)
  isActive     Boolean    @default(true)
  purchases    Purchase[]
  createdAt    DateTime   @default(now())
}

model Sample {
  id          String     @id @default(cuid())
  artistId    String
  artist      Artist     @relation(fields: [artistId], references: [id])
  title       String
  slug        String     @unique
  description String     @default("")
  genre       String     @default("")
  tags        String[]
  artworkUrl  String     @default("")
  previewUrl  String     @default("")
  fileUrl     String     // R2 private key
  price       Float      @default(0)
  bpm         Int        @default(0)
  keySignature String    @default("")
  trackCount  Int        @default(1)
  sales       Int        @default(0)
  isActive    Boolean    @default(true)
  purchases   Purchase[]
  createdAt   DateTime   @default(now())
}

model Subscription {
  id          String    @id @default(cuid())
  artistId    String
  artist      Artist    @relation(fields: [artistId], references: [id])
  title       String
  description String    @default("")
  price       Float
  interval    String    @default("monthly") // monthly, quarterly, yearly
  perks       String[]
  isActive    Boolean   @default(true)
  purchases   Purchase[]
  createdAt   DateTime  @default(now())
}

model Merch {
  id          String     @id @default(cuid())
  artistId    String
  artist      Artist     @relation(fields: [artistId], references: [id])
  title       String
  slug        String     @unique
  description String     @default("")
  imageUrl    String     @default("")
  price       Float
  stock       Int        @default(0)
  sizes       String[]
  isActive    Boolean    @default(true)
  purchases   Purchase[]
  createdAt   DateTime   @default(now())
}

model Purchase {
  id                 String        @id @default(cuid())
  userId             String?
  user               User?         @relation(fields: [userId], references: [id])
  buyerEmail         String
  buyerName          String
  itemType           String        // beat, release, video, sample, subscription, merch
  beatId             String?
  beat               Beat?         @relation(fields: [beatId], references: [id])
  releaseId          String?
  release            Release?      @relation(fields: [releaseId], references: [id])
  videoId            String?
  video              Video?        @relation(fields: [videoId], references: [id])
  sampleId           String?
  sample             Sample?       @relation(fields: [sampleId], references: [id])
  subscriptionId     String?
  subscription       Subscription? @relation(fields: [subscriptionId], references: [id])
  merchId            String?
  merch              Merch?        @relation(fields: [merchId], references: [id])
  amount             Float
  currency           String        @default("ZAR")
  licenseType        String        @default("")
  licenseId          String        @unique @default(cuid())
  stripePaymentId    String?
  payfastPfPaymentId String?
  status             String        @default("pending") // pending, confirmed, refunded
  licenseUrl         String?
  receiptUrl         String?
  downloadToken      String        @unique @default(cuid())
  downloadCount      Int           @default(0)
  platformFee        Float         @default(0) // 2% of amount
  netAmount          Float         @default(0) // amount - platformFee
  createdAt          DateTime      @default(now())
}

model SupportTxn {
  id              String   @id @default(cuid())
  fanUserId       String?
  fan             User?    @relation(fields: [fanUserId], references: [id])
  fanEmail        String
  fanName         String
  artistId        String
  artist          Artist   @relation(fields: [artistId], references: [id])
  amount          Float
  currency        String   @default("ZAR")
  message         String   @default("")
  tier            String   @default("Listener")
  isPublic        Boolean  @default(true)
  stripePaymentId String?
  status          String   @default("pending")
  createdAt       DateTime @default(now())
}

model Goal {
  id            String    @id @default(cuid())
  artistId      String
  artist        Artist    @relation(fields: [artistId], references: [id])
  title         String
  description   String    @default("")
  targetAmount  Float
  currentAmount Float     @default(0)
  currency      String    @default("ZAR")
  deadline      DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
}

model ArtistPayout {
  id               String    @id @default(cuid())
  artistId         String
  artist           Artist    @relation(fields: [artistId], references: [id], onDelete: Cascade)
  purchaseId       String?
  amount           Float
  fee              Float     @default(0)
  netAmount        Float
  method           String    @default("payfast")
  currency         String    @default("ZAR")
  status           String    @default("pending")
  payfastRef       String?
  bankAccountLast4 String?
  notes            String    @default("")
  createdAt        DateTime  @default(now())
  processedAt      DateTime?

  @@index([artistId])
  @@index([status])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  itemType  String
  itemId    String
  createdAt DateTime @default(now())
}

model Follow {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  artistId  String
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, artistId])
  @@index([userId])
  @@index([artistId])
}

// ── INDUSTRY ──────────────────────────────────────────────

model IndustryUser {
  id           String     @id @default(cuid())
  userId       String     @unique
  user         User       @relation(fields: [userId], references: [id])
  company      String     @default("")
  position     String     @default("")
  website      String     @default("")
  referralCode String     @unique @default(cuid())
  totalReferrals Int      @default(0)
  totalEarnings  Float    @default(0)
  referrals    Referral[]
  deals        Deal[]
  createdAt    DateTime   @default(now())
}

model Referral {
  id             String       @id @default(cuid())
  industryUserId String
  industryUser   IndustryUser @relation(fields: [industryUserId], references: [id])
  referredUserId String?
  referralCode   String
  conversionType String       @default("") // register, purchase
  commissionEarned Float      @default(0)
  status         String       @default("pending") // pending, converted, paid
  createdAt      DateTime     @default(now())
}

model Deal {
  id             String       @id @default(cuid())
  industryUserId String
  industryUser   IndustryUser @relation(fields: [industryUserId], references: [id])
  title          String
  description    String       @default("")
  artistSlug     String       @default("")
  dealType       String       @default("licensing") // licensing, distribution, sync, management
  offerAmount    Float        @default(0)
  currency       String       @default("ZAR")
  status         String       @default("pending") // pending, accepted, rejected, negotiating
  adminNotes     String       @default("")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// ── ADMIN / MODERATION ─────────────────────────────────────

model DMCAReport {
  id              String   @id @default(cuid())
  reporterEmail   String
  reporterName    String
  artistId        String?
  artist          Artist?  @relation(fields: [artistId], references: [id])
  itemType        String   // beat, release, video, sample
  itemId          String
  itemTitle       String
  claimDescription String
  originalWorkUrl  String  @default("")
  status          String   @default("pending") // pending, investigating, resolved, dismissed
  adminNotes      String   @default("")
  resolvedAt      DateTime?
  createdAt       DateTime @default(now())
}

model AdminLog {
  id         String   @id @default(cuid())
  action     String
  targetType String   @default("")
  targetId   String   @default("")
  notes      String   @default("")
  createdAt  DateTime @default(now())
}
