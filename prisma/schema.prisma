// for tooling (Prisma Studio etc) run from the project root.
// DO NOT EDIT THIS FILE DIRECTLY. Edit prisma/schema.prisma.
// ============================================================
// VUKA — Final Production Schema (Phase 5 Hardened)
// Merges all phases + Phase 4 additions.
// Run: npx prisma migrate deploy
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── CORE USERS ──────────────────────────────────────────────

model User {
  id              String               @id @default(cuid())
  email           String               @unique
  name            String
  legalName       String?              // full legal name for payout/KYC identity — distinct from public display name
  role            String               @default("fan") // fan, artist, industry, admin, moderator, owner, super_admin
  isSuspended     Boolean              @default(false)
  suspendedAt     DateTime?
  suspendedReason String               @default("")
  createdAt       DateTime             @default(now())
  // ── Founding Artist referral programme ──
  referralCode    String?              @unique  // this user's shareable code (auto-generated on first access)
  referredBy      String?                       // the code used when this user signed up
  referralRewards ReferralReward[]
  // ── Relations ──
  artist          Artist?
  industryUser    IndustryUser?
  purchases       Purchase[]
  supportsSent    SupportTxn[]
  wishlist        WishlistItem[]
  follows         Follow[]
  storyViews      StoryView[]
  memberships     CreatorMembership[]
  marketplaceOrders MarketplaceOrder[] @relation("buyer")
  disputesRaised  MarketplaceDispute[] @relation("disputant")
  reviewsWritten  ServiceReview[]      @relation("reviewer")
  // Phase 3
  sentMessages         Message[]
  notifications        Notification[]
  notificationPrefs    NotificationPreference?
  engagementEvents     EngagementEvent[]
  postComments         PostComment[]
  pageViews            PageView[]
  cmsCollaborations    CmsCollaboration[]
  label                Label?               @relation("LabelOwner")
  labelTeam            LabelTeamMember[]
  fanReferralsMade     FanReferral[]        @relation("FanReferrer")
  fanReferralsReceived FanReferral[]        @relation("FanReferee")
  awardVotes           AwardVote[]
}

model Artist {
  id               String               @id @default(cuid())
  userId           String               @unique
  user             User                 @relation(fields: [userId], references: [id])
  slug             String               @unique
  name             String
  bio              String               @default("")
  city             String               @default("")
  country          String               @default("ZA")
  genreTags        String[]
  photoUrl         String               @default("")
  coverUrl         String               @default("")
  socialLinks      Json                 @default("{}")
  paystackRecipient String?  // bank account number for Paystack payout registration
  paypalEmail      String?   // preferred PayPal email for international payouts
  planSlug         String               @default("free")
  planExpiresAt    DateTime?            // null = never expires (paid ongoing). Set for trial/promo plans.
  currency         String               @default("ZAR")
  isPublic         Boolean              @default(true)
  isVerified       Boolean              @default(false)
  totalPlays       Int                  @default(0)
  // ── Founding Artist Programme ──
  isFoundingArtist   Boolean            @default(false) // permanent badge, granted manually to first 5 completing referral goal
  // ── Auto-stepping fee ──
  lifetimeGrossSales Float              @default(0)     // running total of all confirmed gross sales; used by platformFeeRate()
  beats            Beat[]
  releases         Release[]
  videos           Video[]
  samples          Sample[]
  subscriptions    Subscription[]
  merch            Merch[]
  supportReceived  SupportTxn[]
  goals            Goal[]
  payouts          ArtistPayout[]
  followers        Follow[]
  dmcaReports      DMCAReport[]
  serviceInquiries ServiceInquiry[]
  // Phase 2
  distributionReleases  DistributionRelease[]
  subscriptionTiers     CreatorSubscriptionTier[]
  memberships           CreatorMembership[]
  exclusiveContent      ExclusiveContent[]
  storefront            CreatorStorefront?
  marketplaceServices   MarketplaceService[]
  marketplaceOrdersSold MarketplaceOrder[]        @relation("seller")
  payoutRequests        PayoutRequest[]
  bankAccounts          ArtistBankAccount[]
  revenueRecords        RevenueRecord[]
  taxRecords            TaxRecord[]
  beatLicenses          BeatLicense[]
  invoices              Invoice[]
  // Phase 3
  posts                 ArtistPost[]
  stories               Story[]
  reels                 Reel[]
  slugHistory      ArtistSlugHistory[]
  pageViews             PageView[]
  dailyRollups          AnalyticsDailyRollup[]
  geoEvents             GeographyEvent[]
  verificationRequest   VerificationRequest?
  searchIndex           SearchIndex[]
  planSubscriptions     ArtistPlanSubscription[]
  directPurchases       Purchase[]           @relation("PurchaseArtist")
  featuredArtist        FeaturedArtist?
  // ── New feature relations ──
  plaques               ArtistPlaque[]
  campaigns             Campaign[]
  splitSheets           SplitSheet[]
  events                Event[]
  nominations           AwardNomination[]
  labelRoster            LabelArtist[]
  onboarding            ArtistOnboarding?
  fanReferrals          FanReferral[]
  createdAt             DateTime             @default(now())
}

// ── CONTENT MODELS ──────────────────────────────────────────

model Beat {
  id           String       @id @default(cuid())
  artistId     String
  artist       Artist       @relation(fields: [artistId], references: [id])
  title        String
  slug         String       @unique
  bpm          Int          @default(0)
  keySignature String       @default("")
  mood         String       @default("")
  genre        String       @default("")
  tags         String[]
  artworkUrl   String       @default("")
  previewUrl   String
  fullWavUrl   String       @default("")
  fullMp3Url   String       @default("")
  waveformData Float[]
  basicPrice   Float        @default(0)
  premiumPrice Float        @default(0)
  exclPrice    Float        @default(0)
  plays        Int          @default(0)
  sales        Int          @default(0)
  isActive     Boolean      @default(true)
  isExclusive  Boolean      @default(false)
  purchases    Purchase[]
  licenses     BeatLicense[]
  createdAt    DateTime     @default(now())
}

model Release {
  id          String       @id @default(cuid())
  artistId    String
  artist      Artist       @relation(fields: [artistId], references: [id])
  title       String
  slug        String       @unique
  releaseType String       @default("single")
  price       Float        @default(0)
  minPrice    Float        @default(0)
  payWhatWant Boolean      @default(false)
  artworkUrl  String       @default("")
  description String       @default("")
  credits     String       @default("")
  releaseDate DateTime?
  plays       Int          @default(0)
  sales       Int          @default(0)
  isActive    Boolean      @default(true)
  tracks      Track[]
  purchases   Purchase[]
  createdAt   DateTime     @default(now())
}

model Track {
  id           String   @id @default(cuid())
  releaseId    String
  release      Release  @relation(fields: [releaseId], references: [id])
  title        String
  trackNumber  Int
  duration     Int      @default(0)
  previewUrl   String
  fullUrl      String
  waveformData Float[]
}

model Video {
  id           String     @id @default(cuid())
  artistId     String
  artist       Artist     @relation(fields: [artistId], references: [id])
  title        String
  slug         String     @unique
  description  String     @default("")
  genre        String     @default("")
  tags         String[]
  thumbnailUrl String     @default("")
  videoUrl     String
  previewUrl   String     @default("")
  price        Float      @default(0)
  plays        Int        @default(0)
  sales        Int        @default(0)
  isActive     Boolean    @default(true)
  purchases    Purchase[]
  createdAt    DateTime   @default(now())
}

model Sample {
  id           String     @id @default(cuid())
  artistId     String
  artist       Artist     @relation(fields: [artistId], references: [id])
  title        String
  slug         String     @unique
  description  String     @default("")
  genre        String     @default("")
  tags         String[]
  artworkUrl   String     @default("")
  previewUrl   String     @default("")
  fileUrl      String
  price        Float      @default(0)
  bpm          Int        @default(0)
  keySignature String     @default("")
  trackCount   Int        @default(1)
  sales        Int        @default(0)
  isActive     Boolean    @default(true)
  purchases    Purchase[]
  createdAt    DateTime   @default(now())
}

model Subscription {
  id          String     @id @default(cuid())
  artistId    String
  artist      Artist     @relation(fields: [artistId], references: [id])
  title       String
  description String     @default("")
  price       Float
  interval    String     @default("monthly")
  perks       String[]
  isActive    Boolean    @default(true)
  purchases   Purchase[]
  createdAt   DateTime   @default(now())
}

model Merch {
  id          String     @id @default(cuid())
  artistId    String
  artist      Artist     @relation(fields: [artistId], references: [id])
  title       String
  slug        String     @unique
  description String     @default("")
  imageUrl    String     @default("")
  price       Float
  stock       Int        @default(0)
  sizes       String[]
  isActive    Boolean    @default(true)
  purchases   Purchase[]
  createdAt   DateTime   @default(now())
}

// ── TRANSACTIONS ─────────────────────────────────────────────

model Purchase {
  id                 String       @id @default(cuid())
  userId             String?
  user               User?        @relation(fields: [userId], references: [id])
  buyerEmail         String
  buyerName          String
  itemType           String       // beat, release, video, sample, distribution, subscription, membership, marketplace
  artistId           String?      // direct FK — populated for subscription, membership, marketplace
  artist             Artist?      @relation("PurchaseArtist", fields: [artistId], references: [id])
  beatId             String?
  beat               Beat?        @relation(fields: [beatId], references: [id])
  releaseId          String?
  release            Release?     @relation(fields: [releaseId], references: [id])
  videoId            String?
  video              Video?       @relation(fields: [videoId], references: [id])
  sampleId           String?
  sample             Sample?      @relation(fields: [sampleId], references: [id])
  distributionReleaseId String?
  distributionRelease   DistributionRelease? @relation(fields: [distributionReleaseId], references: [id])
  subscriptionId     String?
  subscription       Subscription? @relation(fields: [subscriptionId], references: [id])
  merchId            String?
  merch              Merch?       @relation(fields: [merchId], references: [id])
  amount             Float
  currency           String       @default("ZAR")
  licenseType        String       @default("")
  licenseId          String       @unique @default(cuid())
  stripePaymentId    String?
  paystackReference  String?
  status             String       @default("pending") // pending, confirmed, refunded
  licenseUrl         String?
  receiptUrl         String?
  downloadToken      String       @unique @default(cuid())
  downloadCount      Int          @default(0)
  platformFee        Float        @default(0)
  netAmount          Float        @default(0)
  beatLicense        BeatLicense?
  invoices           Invoice[]
  createdAt          DateTime     @default(now())

  @@index([status, createdAt])
  @@index([buyerEmail])
  @@index([downloadToken])
  @@index([artistId])
  @@index([distributionReleaseId])
}

model SupportTxn {
  id              String   @id @default(cuid())
  fanUserId       String?
  fan             User?    @relation(fields: [fanUserId], references: [id])
  fanEmail        String
  fanName         String
  artistId        String
  artist          Artist   @relation(fields: [artistId], references: [id])
  amount          Float
  currency        String   @default("ZAR")
  message         String   @default("")
  tier            String   @default("Listener")
  isPublic        Boolean  @default(true)
  stripePaymentId    String?
  paystackReference  String?
  status             String   @default("pending")
  createdAt        DateTime @default(now())
}

model Goal {
  id            String    @id @default(cuid())
  artistId      String
  artist        Artist    @relation(fields: [artistId], references: [id])
  title         String
  description   String    @default("")
  targetAmount  Float
  currentAmount Float     @default(0)
  currency      String    @default("ZAR")
  deadline      DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  itemType  String
  itemId    String
  createdAt DateTime @default(now())

  @@unique([userId, itemType, itemId])
}

model Follow {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  artistId  String
  artist    Artist   @relation(fields: [artistId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, artistId])
  @@index([artistId])
}

// ── STORIES (24h ephemeral updates) ──────────────────────────────
model Story {
  id         String      @id @default(cuid())
  artistId   String
  artist     Artist      @relation(fields: [artistId], references: [id])
  mediaUrl   String
  mediaType  String      @default("image") // image, video
  caption    String      @default("")
  viewCount  Int         @default(0)
  views      StoryView[]
  createdAt  DateTime    @default(now())
  expiresAt  DateTime

  @@index([artistId, expiresAt])
  @@index([expiresAt])
}

model StoryView {
  id        String   @id @default(cuid())
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  viewedAt  DateTime @default(now())

  @@unique([storyId, userId])
  @@index([storyId])
}

// ── REELS (short-form vertical video) ────────────────────────────
model Reel {
  id            String   @id @default(cuid())
  artistId      String
  artist        Artist   @relation(fields: [artistId], references: [id])
  videoUrl      String
  thumbnailUrl  String   @default("")
  caption       String   @default("")
  likeCount     Int      @default(0)
  commentCount  Int      @default(0)
  repostCount   Int      @default(0)
  viewCount     Int      @default(0)
  isPublished   Boolean  @default(true)
  publishedAt   DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([artistId, isPublished, publishedAt])
  @@index([isPublished, publishedAt])
}

// Tracks every slug an artist has ever used so old /artist/<slug> store
// links keep working (301 redirect to the current slug) after someone
// changes their display name in Settings and their slug auto-updates.
model ArtistSlugHistory {
  id        String   @id @default(cuid())
  artistId  String
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  oldSlug   String   @unique
  createdAt DateTime @default(now())

  @@index([artistId])
}

model ArtistPayout {
  id            String   @id @default(cuid())
  artistId      String
  artist        Artist   @relation(fields: [artistId], references: [id])
  amount        Float
  currency      String   @default("ZAR")
  status        String   @default("pending") // pending, processing, paid, failed
  method        String   @default("bank")    // bank, paystack, paypal, flutterwave
  reference     String   @default("")
  purchaseId    String?
  notes         String   @default("")
  processedAt   DateTime?
  createdAt     DateTime @default(now())

  @@index([artistId, status])
}

model DMCAReport {
  id            String    @id @default(cuid())
  artistId      String
  artist        Artist    @relation(fields: [artistId], references: [id])
  contentType   String
  contentId     String
  itemType      String    @default("") // mirrors contentType for legacy route compatibility
  itemId        String    @default("") // mirrors contentId for legacy route compatibility
  itemTitle     String    @default("")
  claimantName  String    @default("")
  claimantEmail String    @default("")
  description   String    @default("")
  status        String    @default("pending") // pending, resolved, rejected, dismissed
  adminNotes    String    @default("")
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())
}

model ServiceInquiry {
  id               String          @id @default(cuid())
  artistId         String
  artist           Artist          @relation(fields: [artistId], references: [id])
  name             String
  email            String
  message          String
  serviceId        String          @default("")
  industryService  IndustryService? @relation(fields: [serviceId], references: [id])
  status           String          @default("pending")
  createdAt        DateTime        @default(now())
}

// ── ADMIN ────────────────────────────────────────────────────

model AdminLog {
  id         String   @id @default(cuid())
  action     String
  targetType String   @default("")
  targetId   String   @default("")
  actorId    String   @default("")
  ipAddress  String   @default("")
  severity   String   @default("info") // info, warn, critical
  notes      String   @default("")
  createdAt  DateTime @default(now())

  @@index([action, createdAt])
}

// ── INDUSTRY ─────────────────────────────────────────────────

model IndustryUser {
  id          String             @id @default(cuid())
  userId      String             @unique
  user        User               @relation(fields: [userId], references: [id])
  companyName String
  role        String             @default("")
  website     String             @default("")
  verified    Boolean            @default(false)
  // ── Earnings / payout ── running totals credited by handleIndustryOrderEvent
  // (industry service order webhook) and debited as withdrawals are paid out.
  totalEarnings  Float           @default(0)
  totalWithdrawn Float           @default(0)
  services       IndustryService[]
  deals          Deal[]
  referrals      IndustryReferral[]
  bankAccounts   IndustryBankAccount[]
  payoutRequests IndustryPayoutRequest[]
  createdAt      DateTime           @default(now())
}

model IndustryBankAccount {
  id                  String        @id @default(cuid())
  industryUserId      String
  industryUser        IndustryUser  @relation(fields: [industryUserId], references: [id])
  bankName            String        @default("")
  accountHolder       String        @default("")
  accountNumber       String        @default("")  // encrypted at rest, mirrors ArtistBankAccount
  maskedNumber        String        @default("")
  branchCode          String        @default("")
  accountType         String        @default("current")
  paypalEmail         String?
  paystackAccountCode String?
  isDefault           Boolean       @default(false)
  isVerified          Boolean       @default(false)
  verifiedAt          DateTime?
  verificationMethod  String        @default("")
  eligibleForPayoutAt DateTime?     // 48h cooldown, same as ArtistBankAccount
  payoutRequests      IndustryPayoutRequest[]
  createdAt           DateTime      @default(now())

  @@index([industryUserId])
}

model IndustryPayoutRequest {
  id                 String    @id @default(cuid())
  industryUserId     String
  industryUser       IndustryUser @relation(fields: [industryUserId], references: [id])
  amount             Float
  currency           String    @default("ZAR")
  bankAccountId      String?
  bankAccount        IndustryBankAccount? @relation(fields: [bankAccountId], references: [id])
  status             String    @default("pending") // pending, approved, processing, paid, rejected
  method             String    @default("bank_transfer")
  paypalEmail        String?
  paystackReference  String?
  adminNotes         String    @default("")
  notes              String    @default("")
  approvedAt         DateTime?
  processedAt        DateTime?
  createdAt          DateTime  @default(now())

  @@index([industryUserId, status])
  @@index([status])
}

model IndustryReferral {
  id               String       @id @default(cuid())
  industryUserId   String
  industryUser     IndustryUser @relation(fields: [industryUserId], references: [id])
  referredUserId   String       @default("")
  artistSlug       String       @default("")
  artistName       String       @default("")
  saleType         String       @default("")
  saleAmount       Float        @default(0)
  commissionRate   Float        @default(0.15)
  commissionEarned Float        @default(0)
  currency         String       @default("ZAR")
  status           String       @default("pending")
  paidAt           DateTime?
  createdAt        DateTime     @default(now())

  @@index([industryUserId, status])
}

model IndustryService {
  id             String            @id @default(cuid())
  industryUserId String
  industryUser   IndustryUser      @relation(fields: [industryUserId], references: [id])
  title          String
  description    String            @default("")
  category       String            @default("")
  price          Float?
  priceZAR       Float             @default(0)
  pricingModel   String            @default("fixed")
  deliveryDays   Int               @default(7)
  currency       String            @default("ZAR")
  isActive       Boolean           @default(true)
  inquiries      ServiceInquiry[]
  createdAt      DateTime          @default(now())
}

model Deal {
  id             String       @id @default(cuid())
  industryUserId String
  industryUser   IndustryUser @relation(fields: [industryUserId], references: [id])
  title          String
  description    String       @default("")
  artistSlug     String       @default("")
  dealType       String       @default("licensing")
  offerAmount    Float        @default(0)
  currency       String       @default("ZAR")
  status         String       @default("open") // open, closed
  createdAt      DateTime     @default(now())
}

// ── PHASE 2: CREATOR ECONOMY ──────────────────────────────────

model CreatorSubscriptionTier {
  id          String              @id @default(cuid())
  artistId    String
  artist      Artist              @relation(fields: [artistId], references: [id])
  name        String
  price       Float
  currency    String              @default("ZAR")
  interval    String              @default("monthly")
  description String              @default("")
  perks       String[]
  isActive    Boolean             @default(true)
  memberships CreatorMembership[]
  createdAt   DateTime            @default(now())
}

model CreatorMembership {
  id              String                  @id @default(cuid())
  userId          String
  user            User                    @relation(fields: [userId], references: [id])
  artistId        String
  artist          Artist                  @relation(fields: [artistId], references: [id])
  tierId          String
  tier            CreatorSubscriptionTier @relation(fields: [tierId], references: [id])
  status            String                  @default("active") // active, pending, cancelled, expired
  billingInterval   String                  @default("monthly") // monthly | yearly
  expiresAt         DateTime?
  paystackReference String?
  createdAt         DateTime                @default(now())

  @@index([artistId])
  @@index([paystackReference])
}

model ExclusiveContent {
  id             String    @id @default(cuid())
  artistId       String
  artist         Artist    @relation(fields: [artistId], references: [id])
  title          String
  description    String    @default("")
  contentType    String    // audio, video, pdf, link, text
  contentUrl     String    @default("")
  fileUrl        String    @default("")
  externalUrl    String    @default("")
  body           String    @default("")
  thumbnailUrl   String    @default("")
  tierId         String?
  accessTierIds  Json      @default("[]")
  isFreePreview  Boolean   @default(false)
  isPublished    Boolean   @default(false)
  isActive       Boolean   @default(true)
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([artistId, isPublished])
}

model CreatorStorefront {
  id          String   @id @default(cuid())
  artistId    String   @unique
  artist      Artist   @relation(fields: [artistId], references: [id])
  headline    String   @default("")
  description String   @default("")
  theme       String   @default("dark")
  sections    Json     @default("[]")
  isPublic    Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model MarketplaceService {
  id            String             @id @default(cuid())
  artistId      String
  artist        Artist             @relation(fields: [artistId], references: [id])
  title         String
  description   String             @default("")
  category      String
  price         Float
  currency      String             @default("ZAR")
  deliveryDays  Int                @default(7)
  revisions     Int                @default(1)
  packages      Json               @default("[]")
  portfolioUrls String[]           @default([])
  requirements  String             @default("")
  isActive      Boolean            @default(true)
  totalOrders   Int                @default(0)
  orders        MarketplaceOrder[]
  reviews       ServiceReview[]
  createdAt     DateTime           @default(now())

  @@index([category, isActive])
}

model MarketplaceOrder {
  id               String              @id @default(cuid())
  serviceId        String
  service          MarketplaceService  @relation(fields: [serviceId], references: [id])
  buyerUserId      String
  buyer            User                @relation("buyer", fields: [buyerUserId], references: [id])
  sellerArtistId   String
  seller           Artist              @relation("seller", fields: [sellerArtistId], references: [id])
  packageName      String
  packagePrice     Float
  currency         String              @default("ZAR")
  status           String              @default("pending") // pending, active, delivered, revision, complete, disputed, cancelled
  requirements     String              @default("")
  deliveryDays     Int
  dueAt            DateTime?
  deliveredAt      DateTime?
  completedAt      DateTime?
  deliverables     String[]
  sellerNotes      String              @default("")
  revisionCount    Int                 @default(0)
  maxRevisions     Int                 @default(1)
  revisionNotes    String              @default("")
  purchaseId       String?
  payfastRef       String?
  stripePaymentId  String?
  platformFee      Float               @default(0)
  netAmount        Float               @default(0)
  paystackReference String?
  dispute          MarketplaceDispute?
  review           ServiceReview?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @default(now())

  @@index([paystackReference])
  @@index([buyerUserId])
  @@index([sellerArtistId])
  @@index([status])
  @@index([serviceId])
}

model MarketplaceDispute {
  id            String           @id @default(cuid())
  orderId       String           @unique
  order         MarketplaceOrder @relation(fields: [orderId], references: [id])
  raisedByUserId String
  disputer      User             @relation("disputant", fields: [raisedByUserId], references: [id])
  reason        String
  status        String           @default("open") // open, resolved, closed
  createdAt     DateTime         @default(now())
}

model ServiceReview {
  id             String           @id @default(cuid())
  orderId        String           @unique
  order          MarketplaceOrder @relation(fields: [orderId], references: [id])
  serviceId      String
  service        MarketplaceService @relation(fields: [serviceId], references: [id])
  reviewerUserId String
  reviewer       User             @relation("reviewer", fields: [reviewerUserId], references: [id])
  rating         Int
  comment        String           @default("")
  createdAt      DateTime         @default(now())
}

model DistributionRelease {
  id               String          @id @default(cuid())
  artistId         String
  artist           Artist          @relation(fields: [artistId], references: [id])
  title            String
  artistName       String          @default("")
  featuredArtists  String[]        @default([])
  releaseType      String          @default("single") // single, ep, album
  primaryGenre     String          @default("")
  secondaryGenre   String          @default("")
  language         String          @default("en")
  labelName        String          @default("")
  distributor      String          @default("")
  upc              String?
  artworkUrl       String          @default("")
  artworkStatus    String          @default("pending") // pending, approved, rejected
  copyrightHolder  String          @default("")
  copyrightYear    Int?
  pLine            String          @default("")
  cLine            String          @default("")
  targetDSPs       String[]
  scheduledDate    DateTime?
  scheduledFor     DateTime?
  originalReleaseDate DateTime?
  catalogNumber    String          @default("")
  adminNotes       String          @default("")
  rejectionReason  String          @default("")
  statusHistory    Json            @default("[]")
  status           String          @default("draft") // draft, pending, submitted, live, rejected, rollback, takedown
  submittedAt      DateTime?
  liveAt           DateTime?
  platforms        String[]
  price            Float           @default(0)
  minPrice         Float           @default(0)
  payWhatYouWant   Boolean         @default(false)
  retryCount       Int             @default(0)
  lastRetryAt      DateTime?
  liveNotifiedAt   DateTime?
  tracks           DistributionTrack[]
  dspDeliveries    DSPDelivery[]
  purchases        Purchase[]
  updatedAt        DateTime        @updatedAt
  createdAt        DateTime        @default(now())

  @@index([artistId, status])
}

model DistributionTrack {
  id               String              @id @default(cuid())
  releaseId        String
  release          DistributionRelease @relation(fields: [releaseId], references: [id])
  title            String
  isrc             String?
  fileUrl          String              @default("")
  masterFileUrl    String              @default("")
  masterFileStatus String              @default("pending") // pending, approved, rejected
  trackNumber      Int
  duration         Int?
  explicit         Boolean             @default(false)
  composers        String[]
  producers        String[]
  featuredArtists  String[]            @default([])
  lyricists        String[]            @default([])
  language         String              @default("en")
  createdAt        DateTime            @default(now())
}

model DSPDelivery {
  id                    String              @id @default(cuid())
  distributionReleaseId String
  distributionRelease   DistributionRelease @relation(fields: [distributionReleaseId], references: [id])
  dsp                   String              // spotify, apple_music, youtube_music, tiktok, deezer, audiomack, amazon_music
  status                String              @default("queued") // queued, submitting, submitted, live, failed, rolled_back
  deliveryPayload       Json                @default("{}")
  dspReferenceId        String?
  errorMessage          String              @default("")
  retryCount            Int                 @default(0)
  submittedAt           DateTime?
  liveAt                DateTime?
  failedAt              DateTime?
  lastRetryAt            DateTime?
  rolledBackAt            DateTime?
  createdAt              DateTime            @default(now())

  @@index([distributionReleaseId, status])
  @@index([dsp, status])
}

model PayoutRequest {
  id                 String    @id @default(cuid())
  artistId           String
  artist             Artist    @relation(fields: [artistId], references: [id])
  amount             Float
  currency           String    @default("ZAR")
  bankAccountId      String?
  bankAccount        ArtistBankAccount? @relation(fields: [bankAccountId], references: [id])
  status             String    @default("pending") // pending, approved, processing, paid, rejected
  method             String    @default("bank_transfer") // bank_transfer, paypal
  paypalEmail        String?   // recipient PayPal email for PayPal payouts
  paystackReference  String?   // Paystack transfer code or PayPal batch ID
  adminNotes         String    @default("")
  notes              String    @default("") // processing notes / rejection reason
  approvedAt         DateTime?
  processedAt        DateTime?
  createdAt          DateTime  @default(now())

  @@index([artistId, status])
  @@index([method])
  @@index([status])
}

model ArtistBankAccount {
  id                  String        @id @default(cuid())
  artistId            String
  artist              Artist        @relation(fields: [artistId], references: [id])
  bankName            String        @default("")
  accountHolder       String        @default("")
  accountNumber       String        @default("")  // stored encrypted in prod; masked in responses
  maskedNumber        String        @default("")
  branchCode          String        @default("")
  accountType         String        @default("bank")
  paypalEmail         String?
  paystackAccountCode String?  // Paystack transfer recipient code
  isDefault           Boolean       @default(false)
  isVerified          Boolean       @default(false)
  verifiedAt          DateTime?     // set only after accountHolder is confirmed to match the real bank account
  verificationMethod  String        @default("") // e.g. "paystack_resolve", "manual_admin_review"
  eligibleForPayoutAt DateTime?     // cooldown: account can't receive a payout until this timestamp,
                                    // set to now()+48h whenever the account is newly added or bank details change
  payoutRequests      PayoutRequest[]
  createdAt           DateTime      @default(now())
}

model RevenueRecord {
  id         String   @id @default(cuid())
  artistId   String
  artist     Artist   @relation(fields: [artistId], references: [id])
  type       String   // beat_sale, release_sale, support, subscription, marketplace
  amount     Float
  currency   String   @default("ZAR")
  platformFee Float   @default(0)
  netAmount  Float    @default(0)
  purchaseId String?
  period     String   @default("") // YYYY-MM
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@index([artistId])
}

model TaxRecord {
  id        String   @id @default(cuid())
  artistId  String
  artist    Artist   @relation(fields: [artistId], references: [id])
  year      Int
  quarter   Int
  totalEarnings Float
  platformFees  Float
  netEarnings   Float
  currency  String   @default("ZAR")
  createdAt DateTime @default(now())
}

model Invoice {
  id         String    @id @default(cuid())
  artistId   String
  artist     Artist    @relation(fields: [artistId], references: [id])
  purchaseId String?
  purchase   Purchase? @relation(fields: [purchaseId], references: [id])
  number     String    @unique
  total      Float
  currency   String    @default("ZAR")
  pdfUrl     String?
  issuedAt   DateTime  @default(now())
  createdAt  DateTime  @default(now())
}

model BeatLicense {
  id            String    @id @default(cuid())
  artistId      String
  artist        Artist    @relation(fields: [artistId], references: [id])
  beatId        String
  beat          Beat      @relation(fields: [beatId], references: [id])
  purchaseId    String    @unique
  purchase      Purchase  @relation(fields: [purchaseId], references: [id])
  licenseKey    String    @unique @default(cuid())
  licenseType   String    // basic, premium, exclusive
  buyerName     String
  buyerEmail    String
  terms         String    @default("")
  isRevoked     Boolean   @default(false)
  revokedReason String    @default("")
  streams       Int?
  salesCap      Int?
  radioStations Boolean   @default(false)
  tvSync        Boolean   @default(false)
  musicVideo    Boolean   @default(false)
  profitSharing Float     @default(0)
  artistName    String    @default("")
  songTitle     String    @default("")
  issuedAt      DateTime  @default(now())
  expiresAt     DateTime?
  pdfUrl        String    @default("")
  createdAt     DateTime  @default(now())

  @@index([licenseKey])
}

// ── PHASE 3: SOCIAL ENGINE ────────────────────────────────────

model ArtistPost {
  id          String        @id @default(cuid())
  artistId    String
  artist      Artist        @relation(fields: [artistId], references: [id])
  body        String
  mediaUrls   String[]      @default([])
  linkUrl     String        @default("")
  linkType    String        @default("") // beat, release, external
  linkItemId  String        @default("")
  likeCount   Int           @default(0)
  commentCount Int          @default(0)
  repostCount Int           @default(0)
  isPinned    Boolean       @default(false)
  isPublished Boolean       @default(true)
  publishedAt DateTime      @default(now())
  comments    PostComment[]
  createdAt   DateTime      @default(now())

  @@index([artistId, isPublished, publishedAt])
}

model PostComment {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id])
  postId     String?
  post       ArtistPost?   @relation(fields: [postId], references: [id])
  beatId     String?
  releaseId  String?
  targetType String        @default("post")
  targetId   String        @default("")
  body       String
  parentId   String?
  parent     PostComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies    PostComment[] @relation("CommentReplies")
  likeCount  Int           @default(0)
  isHidden   Boolean       @default(false)
  isDeleted  Boolean       @default(false)
  updatedAt  DateTime      @updatedAt
  createdAt  DateTime      @default(now())

  @@index([postId])
  @@index([userId])
  @@index([targetType, targetId])
  @@index([parentId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String   // new_follower, new_comment, new_like, new_sale, new_message, milestone_followers, milestone_sales
  title     String
  body      String
  linkType  String   @default("")
  linkId    String   @default("")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}

model NotificationPreference {
  id              String  @id @default(cuid())
  userId          String  @unique
  user            User    @relation(fields: [userId], references: [id])
  emailMessages   Boolean @default(true)
  emailFollowers  Boolean @default(true)
  emailSales      Boolean @default(true)
  emailMilestones Boolean @default(true)
  pushEnabled     Boolean @default(true)
  createdAt       DateTime @default(now())
}

model Message {
  id             String              @id @default(cuid())
  conversationId String
  conversation   MessageConversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User                @relation(fields: [senderId], references: [id])
  body           String
  attachments    Json                @default("[]")
  isRead         Boolean             @default(false)
  readAt         DateTime?
  isFlagged      Boolean             @default(false)
  flagReason     String              @default("")
  isDeleted      Boolean             @default(false)
  deletedAt      DateTime?
  createdAt      DateTime            @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model MessageConversation {
  id                 String    @id @default(cuid())
  participant1       String
  participant2       String
  messages           Message[]
  lastMessageAt      DateTime  @default(now())
  lastMessagePreview String    @default("")
  unread1            Int       @default(0)
  unread2            Int       @default(0)
  isArchived1        Boolean   @default(false)
  isArchived2        Boolean   @default(false)
  updatedAt          DateTime  @updatedAt
  createdAt          DateTime  @default(now())

  @@unique([participant1, participant2])
  @@index([participant1, participant2])
  @@index([lastMessageAt])
}

model EngagementEvent {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  eventType  String   // play, like, follow, purchase, share, comment
  targetType String
  targetId   String
  meta       Json     @default("{}")
  sessionId  String   @default("")
  ipHash     String   @default("")
  country    String   @default("")
  createdAt  DateTime @default(now())

  @@index([userId, eventType, targetType])
  @@index([targetType, targetId])
}

model PageView {
  id         String   @id @default(cuid())
  artistId   String?
  artist     Artist?  @relation(fields: [artistId], references: [id])
  targetType String   @default("")
  targetId   String   @default("")
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  path       String   @default("")
  country    String   @default("")
  referrer   String   @default("")
  sessionId  String   @default("")
  userAgent  String   @default("")
  createdAt  DateTime @default(now())

  @@index([artistId, createdAt])
  @@index([targetType, targetId])
}

model AnalyticsDailyRollup {
  id             String   @id @default(cuid())
  artistId       String
  artist         Artist   @relation(fields: [artistId], references: [id])
  date           String   // YYYY-MM-DD string for easy querying and upsert
  // Play metrics
  plays          Int      @default(0)
  beatPlays      Int      @default(0)
  releasePlays   Int      @default(0)
  videoPlays     Int      @default(0)
  profileViews   Int      @default(0)
  storeViews     Int      @default(0)
  pageViews      Int      @default(0)
  uniqueVisitors Int      @default(0)
  // Follower metrics
  followers      Int      @default(0)
  unfollows      Int      @default(0)
  // Sales metrics
  beatSales      Int      @default(0)
  releaseSales   Int      @default(0)
  // Revenue metrics
  revenue        Float    @default(0)
  totalRevenue   Float    @default(0)
  tips           Float    @default(0)
  // Engagement metrics
  likes          Int      @default(0)
  comments       Int      @default(0)
  reposts        Int      @default(0)
  shares         Int      @default(0)
  createdAt      DateTime @default(now())

  @@unique([artistId, date], name: "artistId_date")
  @@index([artistId, date])
}

model GeographyEvent {
  id          String   @id @default(cuid())
  artistId    String
  artist      Artist   @relation(fields: [artistId], references: [id])
  countryCode String
  countryName String   @default("")
  city        String   @default("")
  eventType   String
  count       Int      @default(1)
  period      String   // YYYY-MM
  createdAt   DateTime @default(now())

  @@unique([artistId, countryCode, eventType, period], map: "GeographyEvent_unique")
  @@index([artistId], map: "GeographyEvent_artistId_idx")
  @@index([period], map: "GeographyEvent_period_idx")
}

model SearchIndex {
  id         String   @id @default(cuid())
  entityType String   // beat, release, artist
  entityId   String
  artistId   String?
  artist     Artist?  @relation(fields: [artistId], references: [id])
  title      String
  subtitle   String   @default("")
  tags       String[]
  genre      String   @default("")
  imageUrl   String   @default("")
  slug       String
  score      Float    @default(0)
  isActive   Boolean  @default(true)
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@unique([entityType, entityId])
  @@index([entityType, isActive, score])
}

model TrendingSnapshot {
  id        String   @id @default(cuid())
  period    String   // hourly, daily, weekly
  category  String   // beats, artists, releases, tags
  items     Json
  createdAt DateTime @default(now())

  @@index([period, category, createdAt])
}

model VerificationRequest {
  id              String    @id @default(cuid())
  artistId        String    @unique
  artist          Artist    @relation(fields: [artistId], references: [id])
  status          String    @default("pending") // pending, approved, rejected
  legalName       String    @default("")
  idDocUrl        String    @default("")
  idDocumentUrl   String    @default("") // alias for idDocUrl used in moderation.ts
  socialLinks     Json      @default("{}")
  socialProofUrl  String    @default("")
  notes           String    @default("")
  additionalInfo  String    @default("")
  monthlyListeners Int      @default(0)
  totalStreams     Int      @default(0)
  reviewedBy      String    @default("")
  reviewedAt      DateTime?
  adminNotes      String    @default("")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now())
}

// ── PHASE 4: MODERATION & TRUST ──────────────────────────────

model AbuseReport {
  id              String    @id @default(cuid())
  reporterUserId  String?
  reporterEmail   String    @default("")
  targetType      String    // beat, release, post, comment, artist, message
  targetId        String
  targetTitle     String    @default("")
  reason          String
  category        String    // harassment, hate_speech, spam, explicit_content, etc.
  description     String    @default("")
  evidence        Json      @default("[]")
  status          String    @default("pending") // pending, reviewed, resolved, dismissed
  resolution      String    @default("")
  moderatorId     String    @default("")
  adminNotes      String    @default("")
  actionTaken     String    @default("")
  assignedTo      String    @default("")
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now())

  @@index([status, createdAt])
}

model ModerationAction {
  id          String       @id @default(cuid())
  reportId    String       @default("") // links to AbuseReport (new)
  adminEmail  String       @default("")
  adminId     String       @default("")
  targetType  String       @default("")
  targetId    String       @default("")
  action      String       // warn, remove_content, suspend_account, ban_account, no_action
  reason      String       @default("")
  notes       String       @default("")
  reversedAt  DateTime?
  reversedBy  String       @default("")
  createdAt   DateTime     @default(now())
}

model ContentFlag {
  id          String    @id @default(cuid())
  contentType String    // beat, release, post, comment, artist
  contentId   String
  flagType    String    // removed, dmca, explicit, spam, copyright, misleading
  adminId     String    @default("")
  reason      String    @default("")
  flaggedBy   String    @default("")
  status      String    @default("open") // open, OPEN, UNDER_REVIEW, RESOLVED, DISMISSED
  reviewedBy  String?
  reviewedAt  DateTime?
  isActive    Boolean   @default(true)
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())

  @@index([status, createdAt])
  @@unique([contentType, contentId, flagType])
}

// ── RATE LIMITING / ANTI-ABUSE ───────────────────────────────

model SpamSignal {
  id          String   @id @default(cuid())
  userId      String
  action      String
  count       Int      @default(1)
  isFlagged   Boolean  @default(false)
  windowStart DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([userId, action, windowStart])
}

// ── PLATFORM SETTINGS ────────────────────────────────────────
// Key-value store for admin-configurable platform settings.
// Keys are unique; values are stored as JSON (booleans, numbers, strings).

model PlatformSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String   @default("")
  updatedAt   DateTime @updatedAt
  updatedBy   String   @default("")
  createdAt   DateTime @default(now())

  @@map("platform_settings")
}

// ── EMAIL SYSTEM (Phase 9) ────────────────────────────────────

model EmailLog {
  id          String   @id @default(cuid())
  to          String
  template    String
  subject     String
  userId      String?
  entityType  String?
  entityId    String?
  resendId    String?
  status      String   @default("sent")
  error       String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([template])
  @@index([createdAt])
  @@map("email_logs")
}

model BroadcastLog {
  id             String   @id @default(cuid())
  sentBy         String
  subject        String
  title          String
  body           String
  ctaLabel       String?
  ctaUrl         String?
  recipientCount Int      @default(0)
  filter         Json?
  createdAt      DateTime @default(now())

  @@map("broadcast_logs")
}

// ── ARTIST PLAN SUBSCRIPTIONS ────────────────────────────────
// Tracks recurring billing for Pro/Label plans via Paystack.

model ArtistPlanSubscription {
  id                  String    @id @default(cuid())
  artistId            String
  artist              Artist    @relation(fields: [artistId], references: [id])
  planSlug            String    // pro | label
  status              String    @default("active") // active | cancelled | expired | failed
  paystackReference  String?   // Paystack payment reference
  paystackToken       String?   // reserved for future recurring billing
  amount              Float
  currency            String    @default("ZAR")
  billingInterval     String    @default("monthly")
  currentPeriodStart  DateTime  @default(now())
  currentPeriodEnd    DateTime
  cancelledAt         DateTime?
  failedAt            DateTime?
  failReason          String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([artistId])
  @@index([status])
  @@map("artist_plan_subscriptions")
}

// ── CMS SYSTEM ────────────────────────────────────────────────────────────────
// In-house CMS: pages, content blocks, media library, revision history,
// collaboration workflow, review comments, and featured artists.

model CmsPage {
  id            String             @id @default(cuid())
  slug          String             @unique
  title         String
  description   String             @default("")
  status        String             @default("draft") // draft | review | approved | published | archived
  isSystem      Boolean            @default(false)   // system pages cannot be deleted
  metaTitle     String             @default("")
  metaDesc      String             @default("")
  publishedAt   DateTime?
  scheduledAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  createdById   String             @default("system")
  updatedById   String             @default("system")

  blocks        CmsBlock[]
  revisions     CmsRevision[]
  collaborators CmsCollaboration[]
  comments      CmsComment[]

  @@index([status])
  @@map("cms_pages")
}

model CmsBlock {
  id        String   @id @default(cuid())
  pageId    String
  page      CmsPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type      String   @default("text")
  label     String   @default("")
  content   Json     @default("{}")
  order     Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId, order])
  @@map("cms_blocks")
}

model CmsRevision {
  id          String   @id @default(cuid())
  pageId      String
  page        CmsPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  blocks      Json     @default("[]")
  summary     String   @default("")
  createdAt   DateTime @default(now())
  createdById String

  @@index([pageId])
  @@map("cms_revisions")
}

model FeaturedArtist {
  id          String   @id @default(cuid())
  artistId    String   @unique
  artist      Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  tagline     String   @default("")
  blurb       String   @default("")
  order       Int      @default(0)
  isVisible   Boolean  @default(true)
  featuredAt  DateTime @default(now())
  createdById String   @default("system")

  @@index([order, isVisible])
  @@map("featured_artists")
}

model CmsMedia {
  id           String   @id @default(cuid())
  filename     String
  originalName String   @default("")
  mimeType     String   @default("")
  size         Int      @default(0)
  r2Key        String   @unique
  publicUrl    String   @default("")
  alt          String   @default("")
  caption      String   @default("")
  width        Int?
  height       Int?
  folder       String   @default("cms")
  uploadedById String
  createdAt    DateTime @default(now())

  @@index([uploadedById])
  @@map("cms_media")
}

model CmsCollaboration {
  id         String   @id @default(cuid())
  pageId     String
  page       CmsPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  canEdit    Boolean  @default(true)
  canPublish Boolean  @default(false)
  addedAt    DateTime @default(now())
  addedById  String

  @@unique([pageId, userId])
  @@index([userId])
  @@map("cms_collaborations")
}

model CmsComment {
  id          String   @id @default(cuid())
  pageId      String
  page        CmsPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  body        String
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())
  createdById String

  @@index([pageId])
  @@map("cms_comments")
}

// ── SECURITY: 2FA · DEVICE SESSIONS · PASSWORD RESET ─────────

model UserTwoFactor {
  id          String    @id @default(cuid())
  userId      String    @unique
  secret      String
  backupCodes String    @default("[]")
  isEnabled   Boolean   @default(false)
  enabledAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("user_two_factor")
}

model UserDeviceSession {
  id          String    @id @default(cuid())
  userId      String
  sessionId   String    @unique
  deviceName  String    @default("Unknown Device")
  browser     String    @default("")
  os          String    @default("")
  ipAddress   String    @default("")
  isCurrent   Boolean   @default(false)
  isRevoked   Boolean   @default(false)
  revokedAt   DateTime?
  lastSeenAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@map("user_device_sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  email     String
  token     String    @unique
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([email])
  @@map("password_reset_tokens")
}

model TwoFactorChallenge {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("two_factor_challenges")
}

// ── FOUNDING ARTIST PROGRAMME ────────────────────────────────────────────────

model ReferralReward {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rewardType  String   @default("pro_3months") // extendable: future reward types go here
  grantedAt   DateTime @default(now())

  @@index([userId])
  @@map("referral_rewards")
}

// ── PLAQUES / ACHIEVEMENTS ────────────────────────────────────────────────────
// Multi-dimensional milestones across sales, streams, membership revenue, followers.
// Each earned plaque is stored permanently. Shareable image URL generated on earn.

model ArtistPlaque {
  id           String   @id @default(cuid())
  artistId     String
  artist       Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  tier         String   // first_sale, bronze, silver, gold, platinum, diamond, multi_platinum
  dimension    String   // sales_units, streams, follower_count, membership_revenue
  milestone    Float    // the numeric threshold achieved
  shareableUrl String   @default("")  // generated OG image for social sharing
  earnedAt     DateTime @default(now())

  @@unique([artistId, tier, dimension])
  @@index([artistId])
  @@map("artist_plaques")
}

// ── CROWDFUNDING CAMPAIGNS ────────────────────────────────────────────────────
// Extends the existing Goal model into full campaigns with backer tiers,
// rewards, all-or-nothing refund logic, and no extra platform fee.

model Campaign {
  id             String          @id @default(cuid())
  artistId       String
  artist         Artist          @relation(fields: [artistId], references: [id], onDelete: Cascade)
  title          String
  description    String          @default("")
  coverUrl       String          @default("")
  targetAmount   Float
  currentAmount  Float           @default(0)
  currency       String          @default("ZAR")
  deadline       DateTime
  campaignType   String          @default("flexible") // flexible | all_or_nothing
  status         String          @default("draft")    // draft, active, funded, failed, cancelled
  slug           String          @unique
  backerCount    Int             @default(0)
  tiers          CampaignTier[]
  backers        CampaignBacker[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([artistId, status])
  @@map("campaigns")
}

model CampaignTier {
  id           String           @id @default(cuid())
  campaignId   String
  campaign     Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title        String
  description  String           @default("")
  amount       Float            // minimum pledge for this tier
  perks        String[]         // list of reward perks
  maxBackers   Int?             // null = unlimited
  backerCount  Int              @default(0)
  backers      CampaignBacker[]
  createdAt    DateTime         @default(now())

  @@index([campaignId])
  @@map("campaign_tiers")
}

model CampaignBacker {
  id                  String        @id @default(cuid())
  campaignId          String
  campaign            Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  tierId              String?
  tier                CampaignTier? @relation(fields: [tierId], references: [id])
  userId              String?
  backerName          String
  backerEmail         String
  amount              Float
  currency            String        @default("ZAR")
  paystackReference   String?
  status              String        @default("pending") // pending, confirmed, refunded
  anonymous           Boolean       @default(false)
  message             String        @default("")
  createdAt           DateTime      @default(now())

  @@index([campaignId, status])
  @@index([backerEmail])
  @@map("campaign_backers")
}

// ── SPLIT SHEETS ──────────────────────────────────────────────────────────────
// Revenue-sharing agreements between collaborators.
// Splits auto-apply at checkout via the earnings resolver.

model SplitSheet {
  id          String          @id @default(cuid())
  artistId    String          // the owning artist (creator of the sheet)
  artist      Artist          @relation(fields: [artistId], references: [id], onDelete: Cascade)
  itemType    String          // beat | release | video | sample | merch
  itemId      String          // the beat/release/video/sample/merch this sheet covers
  title       String          // human label e.g. "Fully Charged Split"
  isLocked    Boolean         @default(false) // locked after first sale — no more edits
  splits      SplitRecipient[]
  disbursements SplitDisbursement[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([itemType, itemId])  // one sheet per content item
  @@index([artistId])
  @@map("split_sheets")
}

model SplitRecipient {
  id            String     @id @default(cuid())
  splitSheetId  String
  splitSheet    SplitSheet @relation(fields: [splitSheetId], references: [id], onDelete: Cascade)
  name          String                     // display name
  email         String                     // for payout routing
  artistId      String?                    // if they're a Vuka artist — auto-links wallet
  role          String     @default("")    // e.g. "Producer", "Feature", "Co-writer"
  percentage    Float                      // must sum to 100 across all recipients
  paystackRecipientCode String @default("") // populated when first payout runs
  createdAt     DateTime   @default(now())

  @@index([splitSheetId])
  @@map("split_recipients")
}

model SplitDisbursement {
  id           String     @id @default(cuid())
  splitSheetId String
  splitSheet   SplitSheet @relation(fields: [splitSheetId], references: [id], onDelete: Cascade)
  purchaseId   String?    // which purchase triggered this disbursement
  totalGross   Float      // gross before platform fee
  platformFee  Float
  totalNet     Float      // distributed across recipients
  status       String     @default("pending") // pending, processing, completed, failed
  processedAt  DateTime?
  createdAt    DateTime   @default(now())

  @@index([splitSheetId])
  @@map("split_disbursements")
}

// ── EVENTS & TICKETING ────────────────────────────────────────────────────────

model Event {
  id           String           @id @default(cuid())
  artistId     String
  artist       Artist           @relation(fields: [artistId], references: [id], onDelete: Cascade)
  title        String
  description  String           @default("")
  venue        String           @default("")
  city         String           @default("")
  province     String           @default("")
  startDate    DateTime
  endDate      DateTime?
  coverUrl     String           @default("")
  status       String           @default("draft")   // draft, published, cancelled, completed
  slug         String           @unique
  tickets      EventTicket[]
  purchases    TicketPurchase[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([artistId, status])
  @@map("events")
}

model EventTicket {
  id          String           @id @default(cuid())
  eventId     String
  event       Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  description String           @default("")
  price       Float
  currency    String           @default("ZAR")
  quantity    Int?
  sold        Int              @default(0)
  purchases   TicketPurchase[]
  createdAt   DateTime         @default(now())

  @@index([eventId])
  @@map("event_tickets")
}

model TicketPurchase {
  id                String      @id @default(cuid())
  eventId           String
  event             Event       @relation(fields: [eventId], references: [id])
  ticketId          String
  ticket            EventTicket @relation(fields: [ticketId], references: [id])
  userId            String?
  buyerName         String
  buyerEmail        String
  quantity          Int         @default(1)
  unitPrice         Float
  totalAmount       Float
  currency          String      @default("ZAR")
  paystackReference String?
  status            String      @default("pending") // pending, confirmed, cancelled, refunded
  qrToken           String      @unique @default(cuid())
  qrSignature       String      @default("") // HMAC(secret, id + qrToken) — verified at the gate, not just looked up
  checkedInAt       DateTime?
  checkedInByUserId String?
  checkInDeviceInfo String      @default("")
  createdAt         DateTime    @default(now())

  @@index([eventId, status])
  @@index([buyerEmail])
  @@map("ticket_purchases")
}

// ── AWARDS & FAN VOTING ───────────────────────────────────────────────────────

model Award {
  id          String          @id @default(cuid())
  title       String
  year        Int
  description String          @default("")
  coverUrl    String          @default("")
  status      String          @default("nominations_open") // nominations_open, voting_open, closed, announced
  categories  AwardCategory[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("awards")
}

model AwardCategory {
  id          String            @id @default(cuid())
  awardId     String
  award       Award             @relation(fields: [awardId], references: [id], onDelete: Cascade)
  name        String
  description String            @default("")
  nominations AwardNomination[]
  createdAt   DateTime          @default(now())

  @@index([awardId])
  @@map("award_categories")
}

model AwardNomination {
  id             String        @id @default(cuid())
  categoryId     String
  category       AwardCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  artistId       String
  artist         Artist        @relation(fields: [artistId], references: [id])
  releaseId      String?
  voteCount      Int           @default(0)
  analyticsScore Float         @default(0)
  finalScore     Float         @default(0)
  isWinner       Boolean       @default(false)
  votes          AwardVote[]
  createdAt      DateTime      @default(now())

  @@unique([categoryId, artistId])
  @@index([categoryId])
  @@map("award_nominations")
}

model AwardVote {
  id             String          @id @default(cuid())
  nominationId   String
  nomination     AwardNomination @relation(fields: [nominationId], references: [id], onDelete: Cascade)
  userId         String
  user           User            @relation(fields: [userId], references: [id])
  createdAt      DateTime        @default(now())

  @@unique([nominationId, userId])
  @@index([nominationId])
  @@map("award_votes")
}

// ── LABEL / ROSTER ────────────────────────────────────────────────────────────

model Label {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  logoUrl     String            @default("")
  description String            @default("")
  website     String            @default("")
  ownerId     String            @unique
  owner       User              @relation("LabelOwner", fields: [ownerId], references: [id])
  roster      LabelArtist[]
  teamMembers LabelTeamMember[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("labels")
}

model LabelArtist {
  id           String   @id @default(cuid())
  labelId      String
  label        Label    @relation(fields: [labelId], references: [id], onDelete: Cascade)
  artistId     String
  artist       Artist   @relation(fields: [artistId], references: [id])
  revenueShare Float    @default(80)    // % the artist keeps; label keeps the rest after Vuka fee
  status       String   @default("pending") // pending, active, inactive
  inviteToken  String   @unique @default(cuid())
  joinedAt     DateTime?
  createdAt    DateTime @default(now())

  @@unique([labelId, artistId])
  @@index([labelId])
  @@map("label_artists")
}

model LabelTeamMember {
  id        String   @id @default(cuid())
  labelId   String
  label     Label    @relation(fields: [labelId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  role      String   @default("manager") // admin, manager, accountant
  createdAt DateTime @default(now())

  @@unique([labelId, userId])
  @@index([labelId])
  @@map("label_team_members")
}

// ── FAN REFERRAL (MEMBERSHIPS) ────────────────────────────────────────────────
// A fan who brings in another fan who buys a membership earns a reward.
// Separate from the artist founding-artist referral system.

model FanReferral {
  id          String   @id @default(cuid())
  referrerId  String
  referrer    User     @relation("FanReferrer", fields: [referrerId], references: [id])
  refereeId   String
  referee     User     @relation("FanReferee", fields: [refereeId], references: [id])
  artistId    String?
  artist      Artist?  @relation(fields: [artistId], references: [id])
  purchaseId  String?
  rewardType  String   @default("account_credit")
  rewardValue Float    @default(0)
  rewarded    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([referrerId, refereeId])
  @@map("fan_referrals")
}

// ── ARTIST ONBOARDING ─────────────────────────────────────────────────────────

model ArtistOnboarding {
  id              String   @id @default(cuid())
  artistId        String   @unique
  artist          Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  hasProfile      Boolean  @default(false)
  hasRelease      Boolean  @default(false)
  hasBankAccount  Boolean  @default(false)
  hasSocials      Boolean  @default(false)
  dismissedAt     DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
