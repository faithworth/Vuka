// ============================================================
// VUKA — Final Production Schema (Phase 5 Hardened)
// Merges all phases + Phase 4 additions.
// Run: npx prisma migrate deploy
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── CORE USERS ──────────────────────────────────────────────

model User {
  id              String               @id @default(cuid())
  email           String               @unique
  name            String
  role            String               @default("fan") // fan, artist, industry, admin
  createdAt       DateTime             @default(now())
  artist          Artist?
  industryUser    IndustryUser?
  purchases       Purchase[]
  supportsSent    SupportTxn[]
  wishlist        WishlistItem[]
  follows         Follow[]
  memberships     CreatorMembership[]
  marketplaceOrders MarketplaceOrder[] @relation("buyer")
  disputesRaised  MarketplaceDispute[] @relation("disputant")
  reviewsWritten  ServiceReview[]      @relation("reviewer")
  // Phase 3
  sentMessages         Message[]
  notifications        Notification[]
  notificationPrefs    NotificationPreference?
  engagementEvents     EngagementEvent[]
  postComments         PostComment[]
  pageViews            PageView[]
}

model Artist {
  id               String               @id @default(cuid())
  userId           String               @unique
  user             User                 @relation(fields: [userId], references: [id])
  slug             String               @unique
  name             String
  bio              String               @default("")
  city             String               @default("")
  country          String               @default("ZA")
  genreTags        String[]
  photoUrl         String               @default("")
  coverUrl         String               @default("")
  socialLinks      Json                 @default("{}")
  stripeAccountId  String?
  payfastMerchant  String?
  currency         String               @default("ZAR")
  isPublic         Boolean              @default(true)
  isVerified       Boolean              @default(false)
  totalPlays       Int                  @default(0)
  beats            Beat[]
  releases         Release[]
  videos           Video[]
  samples          Sample[]
  subscriptions    Subscription[]
  merch            Merch[]
  supportReceived  SupportTxn[]
  goals            Goal[]
  payouts          ArtistPayout[]
  followers        Follow[]
  dmcaReports      DMCAReport[]
  serviceInquiries ServiceInquiry[]
  // Phase 2
  distributionReleases  DistributionRelease[]
  subscriptionTiers     CreatorSubscriptionTier[]
  memberships           CreatorMembership[]
  exclusiveContent      ExclusiveContent[]
  storefront            CreatorStorefront?
  marketplaceServices   MarketplaceService[]
  marketplaceOrdersSold MarketplaceOrder[]        @relation("seller")
  payoutRequests        PayoutRequest[]
  bankAccounts          ArtistBankAccount[]
  revenueRecords        RevenueRecord[]
  taxRecords            TaxRecord[]
  beatLicenses          BeatLicense[]
  invoices              Invoice[]
  // Phase 3
  posts                 ArtistPost[]
  pageViews             PageView[]
  dailyRollups          AnalyticsDailyRollup[]
  geoEvents             GeographyEvent[]
  verificationRequest   VerificationRequest?
  searchIndex           SearchIndex[]
  createdAt             DateTime             @default(now())
}

// ── CONTENT MODELS ──────────────────────────────────────────

model Beat {
  id           String       @id @default(cuid())
  artistId     String
  artist       Artist       @relation(fields: [artistId], references: [id])
  title        String
  slug         String       @unique
  bpm          Int          @default(0)
  keySignature String       @default("")
  mood         String       @default("")
  genre        String       @default("")
  tags         String[]
  artworkUrl   String       @default("")
  previewUrl   String
  fullWavUrl   String       @default("")
  fullMp3Url   String       @default("")
  waveformData Float[]
  basicPrice   Float        @default(0)
  premiumPrice Float        @default(0)
  exclPrice    Float        @default(0)
  plays        Int          @default(0)
  sales        Int          @default(0)
  isActive     Boolean      @default(true)
  isExclusive  Boolean      @default(false)
  purchases    Purchase[]
  licenses     BeatLicense[]
  createdAt    DateTime     @default(now())
}

model Release {
  id          String       @id @default(cuid())
  artistId    String
  artist      Artist       @relation(fields: [artistId], references: [id])
  title       String
  slug        String       @unique
  releaseType String       @default("single")
  price       Float        @default(0)
  minPrice    Float        @default(0)
  payWhatWant Boolean      @default(false)
  artworkUrl  String       @default("")
  description String       @default("")
  credits     String       @default("")
  releaseDate DateTime?
  plays       Int          @default(0)
  sales       Int          @default(0)
  isActive    Boolean      @default(true)
  tracks      Track[]
  purchases   Purchase[]
  createdAt   DateTime     @default(now())
}

model Track {
  id           String   @id @default(cuid())
  releaseId    String
  release      Release  @relation(fields: [releaseId], references: [id])
  title        String
  trackNumber  Int
  duration     Int      @default(0)
  previewUrl   String
  fullUrl      String
  waveformData Float[]
}

model Video {
  id           String     @id @default(cuid())
  artistId     String
  artist       Artist     @relation(fields: [artistId], references: [id])
  title        String
  slug         String     @unique
  description  String     @default("")
  genre        String     @default("")
  tags         String[]
  thumbnailUrl String     @default("")
  videoUrl     String
  previewUrl   String     @default("")
  price        Float      @default(0)
  plays        Int        @default(0)
  sales        Int        @default(0)
  isActive     Boolean    @default(true)
  purchases    Purchase[]
  createdAt    DateTime   @default(now())
}

model Sample {
  id           String     @id @default(cuid())
  artistId     String
  artist       Artist     @relation(fields: [artistId], references: [id])
  title        String
  slug         String     @unique
  description  String     @default("")
  genre        String     @default("")
  tags         String[]
  artworkUrl   String     @default("")
  previewUrl   String     @default("")
  fileUrl      String
  price        Float      @default(0)
  bpm          Int        @default(0)
  keySignature String     @default("")
  trackCount   Int        @default(1)
  sales        Int        @default(0)
  isActive     Boolean    @default(true)
  purchases    Purchase[]
  createdAt    DateTime   @default(now())
}

model Subscription {
  id          String     @id @default(cuid())
  artistId    String
  artist      Artist     @relation(fields: [artistId], references: [id])
  title       String
  description String     @default("")
  price       Float
  interval    String     @default("monthly")
  perks       String[]
  isActive    Boolean    @default(true)
  purchases   Purchase[]
  createdAt   DateTime   @default(now())
}

model Merch {
  id          String     @id @default(cuid())
  artistId    String
  artist      Artist     @relation(fields: [artistId], references: [id])
  title       String
  slug        String     @unique
  description String     @default("")
  imageUrl    String     @default("")
  price       Float
  stock       Int        @default(0)
  sizes       String[]
  isActive    Boolean    @default(true)
  purchases   Purchase[]
  createdAt   DateTime   @default(now())
}

// ── TRANSACTIONS ─────────────────────────────────────────────

model Purchase {
  id                 String       @id @default(cuid())
  userId             String?
  user               User?        @relation(fields: [userId], references: [id])
  buyerEmail         String
  buyerName          String
  itemType           String       // beat, release, video, sample, subscription, merch
  beatId             String?
  beat               Beat?        @relation(fields: [beatId], references: [id])
  releaseId          String?
  release            Release?     @relation(fields: [releaseId], references: [id])
  videoId            String?
  video              Video?       @relation(fields: [videoId], references: [id])
  sampleId           String?
  sample             Sample?      @relation(fields: [sampleId], references: [id])
  subscriptionId     String?
  subscription       Subscription? @relation(fields: [subscriptionId], references: [id])
  merchId            String?
  merch              Merch?       @relation(fields: [merchId], references: [id])
  amount             Float
  currency           String       @default("ZAR")
  licenseType        String       @default("")
  licenseId          String       @unique @default(cuid())
  stripePaymentId    String?
  payfastPfPaymentId String?
  status             String       @default("pending") // pending, confirmed, refunded
  licenseUrl         String?
  receiptUrl         String?
  downloadToken      String       @unique @default(cuid())
  downloadCount      Int          @default(0)
  platformFee        Float        @default(0)
  netAmount          Float        @default(0)
  beatLicense        BeatLicense?
  invoices           Invoice[]
  createdAt          DateTime     @default(now())

  @@index([status, createdAt])
  @@index([buyerEmail])
  @@index([downloadToken])
}

model SupportTxn {
  id              String   @id @default(cuid())
  fanUserId       String?
  fan             User?    @relation(fields: [fanUserId], references: [id])
  fanEmail        String
  fanName         String
  artistId        String
  artist          Artist   @relation(fields: [artistId], references: [id])
  amount          Float
  currency        String   @default("ZAR")
  message         String   @default("")
  tier            String   @default("Listener")
  isPublic        Boolean  @default(true)
  stripePaymentId String?
  status          String   @default("pending")
  createdAt       DateTime @default(now())
}

model Goal {
  id            String    @id @default(cuid())
  artistId      String
  artist        Artist    @relation(fields: [artistId], references: [id])
  title         String
  description   String    @default("")
  targetAmount  Float
  currentAmount Float     @default(0)
  currency      String    @default("ZAR")
  deadline      DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  itemType  String
  itemId    String
  createdAt DateTime @default(now())

  @@unique([userId, itemType, itemId])
}

model Follow {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  artistId  String
  artist    Artist   @relation(fields: [artistId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, artistId])
  @@index([artistId])
}

model ArtistPayout {
  id            String   @id @default(cuid())
  artistId      String
  artist        Artist   @relation(fields: [artistId], references: [id])
  amount        Float
  currency      String   @default("ZAR")
  status        String   @default("pending") // pending, processing, paid, failed
  method        String   @default("bank")    // bank, payfast
  reference     String   @default("")
  purchaseId    String?
  notes         String   @default("")
  processedAt   DateTime?
  createdAt     DateTime @default(now())

  @@index([artistId, status])
}

model DMCAReport {
  id          String   @id @default(cuid())
  artistId    String
  artist      Artist   @relation(fields: [artistId], references: [id])
  contentType String
  contentId   String
  claimantName String  @default("")
  claimantEmail String @default("")
  description String   @default("")
  status      String   @default("pending") // pending, resolved, rejected
  createdAt   DateTime @default(now())
}

model ServiceInquiry {
  id               String          @id @default(cuid())
  artistId         String
  artist           Artist          @relation(fields: [artistId], references: [id])
  name             String
  email            String
  message          String
  serviceId        String          @default("")
  industryService  IndustryService? @relation(fields: [serviceId], references: [id])
  status           String          @default("pending")
  createdAt        DateTime        @default(now())
}

// ── ADMIN ────────────────────────────────────────────────────

model AdminLog {
  id         String   @id @default(cuid())
  action     String
  targetType String   @default("")
  targetId   String   @default("")
  actorId    String   @default("")
  ipAddress  String   @default("")
  severity   String   @default("info") // info, warn, critical
  notes      String   @default("")
  createdAt  DateTime @default(now())

  @@index([action, createdAt])
}

// ── INDUSTRY ─────────────────────────────────────────────────

model IndustryUser {
  id          String             @id @default(cuid())
  userId      String             @unique
  user        User               @relation(fields: [userId], references: [id])
  companyName String
  role        String             @default("")
  website     String             @default("")
  verified    Boolean            @default(false)
  services    IndustryService[]
  deals       Deal[]
  referrals   IndustryReferral[]
  createdAt   DateTime           @default(now())
}

model IndustryReferral {
  id               String       @id @default(cuid())
  industryUserId   String
  industryUser     IndustryUser @relation(fields: [industryUserId], references: [id])
  referredUserId   String       @default("")
  artistSlug       String       @default("")
  artistName       String       @default("")
  saleType         String       @default("")
  saleAmount       Float        @default(0)
  commissionRate   Float        @default(0.15)
  commissionEarned Float        @default(0)
  currency         String       @default("ZAR")
  status           String       @default("pending")
  paidAt           DateTime?
  createdAt        DateTime     @default(now())

  @@index([industryUserId, status])
}

model IndustryService {
  id             String            @id @default(cuid())
  industryUserId String
  industryUser   IndustryUser      @relation(fields: [industryUserId], references: [id])
  title          String
  description    String            @default("")
  category       String            @default("")
  price          Float?
  priceZAR       Float             @default(0)
  pricingModel   String            @default("fixed")
  deliveryDays   Int               @default(7)
  currency       String            @default("ZAR")
  isActive       Boolean           @default(true)
  inquiries      ServiceInquiry[]
  createdAt      DateTime          @default(now())
}

model Deal {
  id             String       @id @default(cuid())
  industryUserId String
  industryUser   IndustryUser @relation(fields: [industryUserId], references: [id])
  title          String
  description    String       @default("")
  artistSlug     String       @default("")
  dealType       String       @default("licensing")
  offerAmount    Float        @default(0)
  currency       String       @default("ZAR")
  status         String       @default("open") // open, closed
  createdAt      DateTime     @default(now())
}

// ── PHASE 2: CREATOR ECONOMY ──────────────────────────────────

model CreatorSubscriptionTier {
  id          String              @id @default(cuid())
  artistId    String
  artist      Artist              @relation(fields: [artistId], references: [id])
  name        String
  price       Float
  currency    String              @default("ZAR")
  interval    String              @default("monthly")
  description String              @default("")
  perks       String[]
  isActive    Boolean             @default(true)
  memberships CreatorMembership[]
  createdAt   DateTime            @default(now())
}

model CreatorMembership {
  id        String                  @id @default(cuid())
  userId    String
  user      User                    @relation(fields: [userId], references: [id])
  artistId  String
  artist    Artist                  @relation(fields: [artistId], references: [id])
  tierId    String
  tier      CreatorSubscriptionTier @relation(fields: [tierId], references: [id])
  status    String                  @default("active") // active, cancelled, expired
  expiresAt DateTime?
  createdAt DateTime                @default(now())

  @@index([artistId])
}

model ExclusiveContent {
  id             String    @id @default(cuid())
  artistId       String
  artist         Artist    @relation(fields: [artistId], references: [id])
  title          String
  description    String    @default("")
  contentType    String    // audio, video, pdf, link, text
  contentUrl     String    @default("")
  fileUrl        String    @default("")
  externalUrl    String    @default("")
  body           String    @default("")
  thumbnailUrl   String    @default("")
  tierId         String?
  accessTierIds  Json      @default("[]")
  isFreePreview  Boolean   @default(false)
  isPublished    Boolean   @default(false)
  isActive       Boolean   @default(true)
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([artistId, isPublished])
}

model CreatorStorefront {
  id          String   @id @default(cuid())
  artistId    String   @unique
  artist      Artist   @relation(fields: [artistId], references: [id])
  headline    String   @default("")
  description String   @default("")
  theme       String   @default("dark")
  sections    Json     @default("[]")
  isPublic    Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model MarketplaceService {
  id            String             @id @default(cuid())
  artistId      String
  artist        Artist             @relation(fields: [artistId], references: [id])
  title         String
  description   String             @default("")
  category      String
  price         Float
  currency      String             @default("ZAR")
  deliveryDays  Int                @default(7)
  revisions     Int                @default(1)
  packages      Json               @default("[]")
  portfolioUrls String[]           @default([])
  requirements  String             @default("")
  isActive      Boolean            @default(true)
  orders        MarketplaceOrder[]
  reviews       ServiceReview[]
  createdAt     DateTime           @default(now())

  @@index([category, isActive])
}

model MarketplaceOrder {
  id          String              @id @default(cuid())
  serviceId   String
  service     MarketplaceService  @relation(fields: [serviceId], references: [id])
  buyerId     String
  buyer       User                @relation("buyer", fields: [buyerId], references: [id])
  sellerId    String
  seller      Artist              @relation("seller", fields: [sellerId], references: [id])
  amount      Float
  currency    String              @default("ZAR")
  status      String              @default("pending") // pending, active, delivered, revision, complete, disputed, cancelled
  requirements String             @default("")
  deliverables String[]
  deadline    DateTime?
  dispute     MarketplaceDispute?
  review      ServiceReview?
  createdAt   DateTime            @default(now())
}

model MarketplaceDispute {
  id        String           @id @default(cuid())
  orderId   String           @unique
  order     MarketplaceOrder @relation(fields: [orderId], references: [id])
  raisedBy  String
  disputer  User             @relation("disputant", fields: [raisedBy], references: [id])
  reason    String
  status    String           @default("open") // open, resolved, closed
  createdAt DateTime         @default(now())
}

model ServiceReview {
  id        String           @id @default(cuid())
  orderId   String           @unique
  order     MarketplaceOrder @relation(fields: [orderId], references: [id])
  serviceId String
  service   MarketplaceService @relation(fields: [serviceId], references: [id])
  reviewerId String
  reviewer  User             @relation("reviewer", fields: [reviewerId], references: [id])
  rating    Int
  body      String           @default("")
  createdAt DateTime         @default(now())
}

model DistributionRelease {
  id               String          @id @default(cuid())
  artistId         String
  artist           Artist          @relation(fields: [artistId], references: [id])
  title            String
  artistName       String          @default("")
  featuredArtists  String[]        @default([])
  releaseType      String          @default("single") // single, ep, album
  primaryGenre     String          @default("")
  secondaryGenre   String          @default("")
  language         String          @default("en")
  labelName        String          @default("")
  distributor      String          @default("")
  upc              String?
  artworkUrl       String          @default("")
  artworkStatus    String          @default("pending") // pending, approved, rejected
  copyrightHolder  String          @default("")
  copyrightYear    Int?
  pLine            String          @default("")
  cLine            String          @default("")
  targetDSPs       String[]
  scheduledDate    DateTime?
  scheduledFor     DateTime?
  originalReleaseDate DateTime?
  catalogNumber    String          @default("")
  adminNotes       String          @default("")
  rejectionReason  String          @default("")
  statusHistory    Json            @default("[]")
  status           String          @default("draft") // draft, pending, submitted, live, rejected, rollback, takedown
  submittedAt      DateTime?
  liveAt           DateTime?
  platforms        String[]
  retryCount       Int             @default(0)
  lastRetryAt      DateTime?
  tracks           DistributionTrack[]
  dspDeliveries    DSPDelivery[]
  updatedAt        DateTime        @updatedAt
  createdAt        DateTime        @default(now())

  @@index([artistId, status])
}

model DistributionTrack {
  id               String              @id @default(cuid())
  releaseId        String
  release          DistributionRelease @relation(fields: [releaseId], references: [id])
  title            String
  isrc             String?
  fileUrl          String              @default("")
  masterFileUrl    String              @default("")
  masterFileStatus String              @default("pending") // pending, approved, rejected
  trackNumber      Int
  duration         Int?
  explicit         Boolean             @default(false)
  composers        String[]
  producers        String[]
  featuredArtists  String[]            @default([])
  lyricists        String[]            @default([])
  language         String              @default("en")
  createdAt        DateTime            @default(now())
}

model DSPDelivery {
  id                    String              @id @default(cuid())
  distributionReleaseId String
  distributionRelease   DistributionRelease @relation(fields: [distributionReleaseId], references: [id])
  dsp                   String              // spotify, apple_music, youtube_music, tiktok, deezer, audiomack, amazon_music
  status                String              @default("queued") // queued, submitting, submitted, live, failed, rolled_back
  deliveryPayload       Json                @default("{}")
  dspReferenceId        String?
  errorMessage          String              @default("")
  retryCount            Int                 @default(0)
  submittedAt           DateTime?
  liveAt                DateTime?
  failedAt              DateTime?
  lastRetryAt           DateTime?
  rolledBackAt          DateTime?
  createdAt             DateTime            @default(now())

  @@index([distributionReleaseId, status])
  @@index([dsp, status])
}

model PayoutRequest {
  id              String   @id @default(cuid())
  artistId        String
  artist          Artist   @relation(fields: [artistId], references: [id])
  amount          Float
  currency        String   @default("ZAR")
  bankAccountId   String?
  bankAccount     ArtistBankAccount? @relation(fields: [bankAccountId], references: [id])
  status          String   @default("pending") // pending, approved, paid, rejected
  adminNotes      String   @default("")
  processedAt     DateTime?
  createdAt       DateTime @default(now())

  @@index([artistId, status])
}

model ArtistBankAccount {
  id                  String        @id @default(cuid())
  artistId            String
  artist              Artist        @relation(fields: [artistId], references: [id])
  bankName            String        @default("")
  accountHolder       String        @default("")
  accountNumber       String        @default("")  // stored encrypted in prod; masked in responses
  maskedNumber        String        @default("")
  branchCode          String        @default("")
  accountType         String        @default("bank")
  paypalEmail         String?
  payfastMerchantId   String?
  isDefault           Boolean       @default(false)
  isVerified          Boolean       @default(false)
  payoutRequests      PayoutRequest[]
  createdAt           DateTime      @default(now())
}

model RevenueRecord {
  id         String   @id @default(cuid())
  artistId   String
  artist     Artist   @relation(fields: [artistId], references: [id])
  type       String   // beat_sale, release_sale, support, subscription, marketplace
  amount     Float
  currency   String   @default("ZAR")
  platformFee Float   @default(0)
  netAmount  Float    @default(0)
  purchaseId String?
  period     String   @default("") // YYYY-MM
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@index([artistId])
}

model TaxRecord {
  id        String   @id @default(cuid())
  artistId  String
  artist    Artist   @relation(fields: [artistId], references: [id])
  year      Int
  quarter   Int
  totalEarnings Float
  platformFees  Float
  netEarnings   Float
  currency  String   @default("ZAR")
  createdAt DateTime @default(now())
}

model Invoice {
  id         String    @id @default(cuid())
  artistId   String
  artist     Artist    @relation(fields: [artistId], references: [id])
  purchaseId String?
  purchase   Purchase? @relation(fields: [purchaseId], references: [id])
  number     String    @unique
  total      Float
  currency   String    @default("ZAR")
  pdfUrl     String?
  issuedAt   DateTime  @default(now())
  createdAt  DateTime  @default(now())
}

model BeatLicense {
  id            String    @id @default(cuid())
  artistId      String
  artist        Artist    @relation(fields: [artistId], references: [id])
  beatId        String
  beat          Beat      @relation(fields: [beatId], references: [id])
  purchaseId    String    @unique
  purchase      Purchase  @relation(fields: [purchaseId], references: [id])
  licenseKey    String    @unique @default(cuid())
  licenseType   String    // basic, premium, exclusive
  buyerName     String
  buyerEmail    String
  terms         String    @default("")
  isRevoked     Boolean   @default(false)
  revokedReason String    @default("")
  streams       Int?
  salesCap      Int?
  radioStations Boolean   @default(false)
  tvSync        Boolean   @default(false)
  musicVideo    Boolean   @default(false)
  profitSharing Float     @default(0)
  artistName    String    @default("")
  songTitle     String    @default("")
  issuedAt      DateTime  @default(now())
  expiresAt     DateTime?
  pdfUrl        String    @default("")
  createdAt     DateTime  @default(now())

  @@index([licenseKey])
}

// ── PHASE 3: SOCIAL ENGINE ────────────────────────────────────

model ArtistPost {
  id          String        @id @default(cuid())
  artistId    String
  artist      Artist        @relation(fields: [artistId], references: [id])
  body        String
  mediaUrls   String[]      @default([])
  linkUrl     String        @default("")
  linkType    String        @default("") // beat, release, external
  linkItemId  String        @default("")
  likeCount   Int           @default(0)
  commentCount Int          @default(0)
  repostCount Int           @default(0)
  isPinned    Boolean       @default(false)
  isPublished Boolean       @default(true)
  publishedAt DateTime      @default(now())
  comments    PostComment[]
  createdAt   DateTime      @default(now())

  @@index([artistId, isPublished, publishedAt])
}

model PostComment {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  postId     String?
  post       ArtistPost? @relation(fields: [postId], references: [id])
  beatId     String?
  releaseId  String?
  targetType String      @default("post")
  targetId   String      @default("")
  body       String
  parentId   String?
  likeCount  Int         @default(0)
  isHidden   Boolean     @default(false)
  isDeleted  Boolean     @default(false)
  updatedAt  DateTime    @updatedAt
  createdAt  DateTime    @default(now())

  @@index([postId])
  @@index([userId])
  @@index([targetType, targetId])
  @@index([parentId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String   // new_follower, new_comment, new_like, new_sale, new_message, milestone_followers, milestone_sales
  title     String
  body      String
  linkType  String   @default("")
  linkId    String   @default("")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}

model NotificationPreference {
  id              String  @id @default(cuid())
  userId          String  @unique
  user            User    @relation(fields: [userId], references: [id])
  emailMessages   Boolean @default(true)
  emailFollowers  Boolean @default(true)
  emailSales      Boolean @default(true)
  emailMilestones Boolean @default(true)
  pushEnabled     Boolean @default(true)
  createdAt       DateTime @default(now())
}

model Message {
  id             String              @id @default(cuid())
  conversationId String
  conversation   MessageConversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User                @relation(fields: [senderId], references: [id])
  body           String
  attachments    Json                @default("[]")
  isRead         Boolean             @default(false)
  readAt         DateTime?
  isFlagged      Boolean             @default(false)
  flagReason     String              @default("")
  isDeleted      Boolean             @default(false)
  deletedAt      DateTime?
  createdAt      DateTime            @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model MessageConversation {
  id                 String    @id @default(cuid())
  participant1       String
  participant2       String
  messages           Message[]
  lastMessageAt      DateTime  @default(now())
  lastMessagePreview String    @default("")
  unread1            Int       @default(0)
  unread2            Int       @default(0)
  isArchived1        Boolean   @default(false)
  isArchived2        Boolean   @default(false)
  updatedAt          DateTime  @updatedAt
  createdAt          DateTime  @default(now())

  @@unique([participant1, participant2])
  @@index([participant1, participant2])
  @@index([lastMessageAt])
}

model EngagementEvent {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  eventType  String   // play, like, follow, purchase, share, comment
  targetType String
  targetId   String
  meta       Json     @default("{}")
  sessionId  String   @default("")
  ipHash     String   @default("")
  country    String   @default("")
  createdAt  DateTime @default(now())

  @@index([userId, eventType, targetType])
  @@index([targetType, targetId])
}

model PageView {
  id         String   @id @default(cuid())
  artistId   String?
  artist     Artist?  @relation(fields: [artistId], references: [id])
  targetType String   @default("")
  targetId   String   @default("")
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  path       String   @default("")
  country    String   @default("")
  referrer   String   @default("")
  sessionId  String   @default("")
  userAgent  String   @default("")
  createdAt  DateTime @default(now())

  @@index([artistId, createdAt])
  @@index([targetType, targetId])
}

model AnalyticsDailyRollup {
  id             String   @id @default(cuid())
  artistId       String
  artist         Artist   @relation(fields: [artistId], references: [id])
  date           String   // YYYY-MM-DD string for easy querying and upsert
  // Play metrics
  plays          Int      @default(0)
  beatPlays      Int      @default(0)
  releasePlays   Int      @default(0)
  videoPlays     Int      @default(0)
  profileViews   Int      @default(0)
  storeViews     Int      @default(0)
  pageViews      Int      @default(0)
  uniqueVisitors Int      @default(0)
  // Follower metrics
  followers      Int      @default(0)
  unfollows      Int      @default(0)
  // Sales metrics
  beatSales      Int      @default(0)
  releaseSales   Int      @default(0)
  // Revenue metrics
  revenue        Float    @default(0)
  totalRevenue   Float    @default(0)
  tips           Float    @default(0)
  // Engagement metrics
  likes          Int      @default(0)
  comments       Int      @default(0)
  reposts        Int      @default(0)
  shares         Int      @default(0)
  createdAt      DateTime @default(now())

  @@unique([artistId, date], name: "artistId_date")
  @@index([artistId, date])
}

model GeographyEvent {
  id          String   @id @default(cuid())
  artistId    String
  artist      Artist   @relation(fields: [artistId], references: [id])
  countryCode String
  countryName String   @default("")
  city        String   @default("")
  eventType   String
  count       Int      @default(1)
  period      String   // YYYY-MM
  createdAt   DateTime @default(now())

  @@unique([artistId, countryCode, eventType, period], map: "GeographyEvent_unique")
  @@index([artistId], map: "GeographyEvent_artistId_idx")
  @@index([period], map: "GeographyEvent_period_idx")
}

model SearchIndex {
  id         String   @id @default(cuid())
  entityType String   // beat, release, artist
  entityId   String
  artistId   String?
  artist     Artist?  @relation(fields: [artistId], references: [id])
  title      String
  subtitle   String   @default("")
  tags       String[]
  genre      String   @default("")
  imageUrl   String   @default("")
  slug       String
  score      Float    @default(0)
  isActive   Boolean  @default(true)
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@unique([entityType, entityId])
  @@index([entityType, isActive, score])
}

model TrendingSnapshot {
  id        String   @id @default(cuid())
  period    String   // hourly, daily, weekly
  category  String   // beats, artists, releases, tags
  items     Json
  createdAt DateTime @default(now())

  @@index([period, category, createdAt])
}

model VerificationRequest {
  id          String    @id @default(cuid())
  artistId    String    @unique
  artist      Artist    @relation(fields: [artistId], references: [id])
  status      String    @default("pending") // pending, approved, rejected
  idDocUrl    String    @default("")
  socialLinks Json      @default("{}")
  notes       String    @default("")
  reviewedAt  DateTime?
  adminNotes  String    @default("")
  createdAt   DateTime  @default(now())
}

// ── PHASE 4: MODERATION & TRUST ──────────────────────────────

model AbuseReport {
  id              String             @id @default(cuid())
  reporterUserId  String?
  reporterEmail   String             @default("")
  targetType      String             // beat, release, post, comment, artist, message
  targetId        String
  targetTitle     String             @default("")
  reason          String
  category        String             // harassment, hate_speech, spam, explicit_content, etc.
  description     String             @default("")
  evidence        Json               @default("[]")
  status          String             @default("pending") // pending, reviewed, resolved, dismissed
  resolution      String             @default("")
  moderatorId     String             @default("")
  actions         ModerationAction[]
  createdAt       DateTime           @default(now())

  @@index([status, createdAt])
}

model ModerationAction {
  id        String      @id @default(cuid())
  reportId  String
  report    AbuseReport @relation(fields: [reportId], references: [id])
  adminId   String      @default("")
  action    String      // warn, remove_content, suspend_account, ban_account, no_action
  notes     String      @default("")
  createdAt DateTime    @default(now())
}

model ContentFlag {
  id         String   @id @default(cuid())
  targetType String
  targetId   String
  flagType   String   // explicit, spam, copyright, misleading
  isActive   Boolean  @default(true)
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@unique([targetType, targetId, flagType])
}

// ── RATE LIMITING / ANTI-ABUSE ───────────────────────────────

model SpamSignal {
  id          String   @id @default(cuid())
  userId      String
  action      String
  count       Int      @default(1)
  isFlagged   Boolean  @default(false)
  windowStart DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([userId, action, windowStart])
}
