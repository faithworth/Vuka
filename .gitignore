# Dependencies
/node_modules
/.pnp
.pnp.js

# Testing
/coverage

# Next.js
/.next/
/out/

# Production
/build

# Misc
.DS_Store
*.pem
.vscode/*
!.vscode/extensions.json
.idea

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Env files — never commit real secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# Vercel
.vercel

# TypeScript
# NOTE: next-env.d.ts is intentionally NOT ignored here — Next.js regenerates
# it automatically, but keeping it tracked avoids `tsc --noEmit` failing on a
# fresh clone / CI runner before `next dev`/`next build` has run once.
# See: github.com/t3-oss/create-t3-turbo/issues/472
*.tsbuildinfo

# Prisma
# Generated client is rebuilt by `postinstall`/`prisma generate` — never commit it
/node_modules/.prisma

# Doppler
doppler.yaml

# Local scratch
*.local
